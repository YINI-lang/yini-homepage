// YINI settings/configuration file.

@yini

/*
    Formatting tip:
    Separate sibling sections with blank lines to make
    large configuration files easier to scan.
*/


// ============================================================
// Meta information
// ============================================================
^ meta
    homepageURL = 'https://yini-lang.org/'
    author = 'Marko K. Seppänen'


// ============================================================
// Plain human text
// ============================================================

^ text
    // Branding tagLine.
    // A small, restrained subtitle under (or to the right) of the logo.
    // NOTE: This line is only secondary to the logo.
    // Must stay quiet and NOT compete with the hero or main tagLine.
    logoTagLine = 'A clear and structured config format'

    headline = [
        'YINI — Readable like INI, structured like JSON, without indentation pitfalls.',
        'YINI — Readable like INI, structured like JSON — no indentation surprises.',
        'YINI — Readable like INI. Structured like JSON. No indentation surprises.',
        'YINI — Structured Configuration That Stays Readable',
        'YINI — Simple to Read, Structured by Design',
        'YINI: INI familiarity. Structured clarity. Predictable behavior.',
        'YINI — A Predictable Format for Real-World Configs',
        'YINI — Configuration with Clear Rules',
        'YINI — A Human-Friendly Configuration Format',
        'YINI — Readable Like INI, Structured Like JSON',
        "YINI — Configuration Without YAML's Surprises",
        'YINI — Less verbose than JSON, simpler than YAML, and more expressive than INI, while staying clear.',
        'YINI — Configuration That Grows Without the Pain',
        'YINI — Clean, Calm Configuration for Complex Systems',
        'YINI — A human-friendly, text-based configuration format that stays clear and predictable.'
    ]

    tagLine = 'Human-readable configuration files with clear structure and predictable parsing.'
    elevatorPitch = "YINI is a human-friendly, INI-inspired text-based configuration format for software projects: readable like INI, structured like JSON, without YAML's surprises. It offers clear nesting, comments, and predictable parsing, so your configuration stays easy to read and reason about as it grows. Suitable for configuration files, application settings, and general data storage."

    ^^ mainPage
        headTitle = 'YINI — Human-Friendly Configuration Format with Real Structure'
        headDescription = 'YINI is a human-friendly, text-based configuration format with clear structure, nested sections, and predictable parsing.'


// ============================================================
// siteLinks
// ============================================================

^ siteLinks

    // ------------------------------------------------------------
    // hero
    // ------------------------------------------------------------

    ^^ hero

        ^^^ home
            url = '/'
            title = 'Home – YINI homepage'

        ^^^ getStarted
            url = '/use-yini/get-started'
            title = 'Start exploring the YINI format.'

        ^^^ playground
            url = '/playground'
            title = 'Experiment with YINI directly in your browser.'

        ^^^ tutorial
            url = '/learn-yini/quick-tutorial'
            title = 'A 5-minute guided walkthrough of YINI.'

        ^^^ examples
            url = '/learn-yini/examples/'
            title = 'Practical YINI configuration examples.'

        ^^^ spec
            url = '/refs/specification'
            title = 'Read the full YINI specification and syntax reference.'

        ^^^ faq
            url = '/refs/yini-faq'
            title = 'Read frequently asked questions about YINI.'


    // ------------------------------------------------------------
    // Navigation Menu
    // ------------------------------------------------------------

    ^^ navMenu

        ^^^ start

            ^^^^ whatIsYINIAndWhy
                url = '/start/what-is-yini-and-why'
                title = 'Learn what YINI is and why it exists.'

        ^^^ learnYini

            ^^^^ learnYiniFormat
                url = '/learn-yini/learn-yini-config-format'
                title = 'Learn what YINI is and how the format works.'

            ^^^^ quickTutorial
                url = '/learn-yini/quick-tutorial'
                title = 'A 5-minute guided walkthrough of YINI.'

            ^^^^ examples

                ^^^^^ index
                    url = '/learn-yini/examples/'
                    title = 'Practical YINI configuration examples.'

                ^^^^^ basic
                    url = '/learn-yini/examples/basic'
                    title = 'Core and practical YINI config examples.'

                ^^^^^ common
                    url = '/learn-yini/examples/common'
                    title = 'Common real-world examples.'

                ^^^^^ advanced
                    url = '/learn-yini/examples/advanced'
                    title = 'Examples with optional syntax, edge cases, and power features.'

                ^^^^^ large
                    url = '/learn-yini/examples/large'
                    title = 'Large YINI configuration examples.'

        ^^^ useYini

            ^^^^ getStarted
                url = '/use-yini/get-started'
                title = 'Start exploring the YINI format.'

            ^^^^ yiniParsers
                url = '/tools/yini-parsers'
                title = 'YINI parsers to load YINI files in app code.'

            ^^^^ getYINITools
                url = '/use-yini/get-yini-tools'
                title = 'Get YINI parsers, tools, and related implementations across different languages and platforms.'

        ^^^ refs

            ^^^^ faq
                url = '/refs/yini-faq'
                title = 'Read frequently asked questions about YINI.'

            ^^^^ spec
                url = '/refs/specification'
                title = 'Formal YINI specification and syntax reference.'

            ^^^^ cheatSheet
                url = '/refs/yini-cheat-sheet'
                title = 'A quick reference for writing clean, readable YINI configuration files.'

        ^^^ metaInfo

            ^^^^ about
                url = '/info/about-yini'
                title = "Who's behind YINI" // Double quotes used due to ' in the string.


    ^^ specPdf
        url = '<dummy>'
        title = 'Download the latest YINI specification (PDF)'


// ============================================================
// URLs
// ============================================================

^ urls

    // ------------------------------------------------------------
    // External URLs
    // ------------------------------------------------------------

    ^^ external

        specOnGitHubAtProd = 'https://github.com/YINI-lang/YINI-spec/blob/production/YINI-Specification.md'

        ^^^ useIt
            npmYiniCli = 'https://www.npmjs.com/package/yini-cli'
            npmYiniParser = 'https://www.npmjs.com/package/yini-parser'
            pypiYiniParser = 'https://pypi.org/project/yini-parser/'

        ^^^ gitHub
            yiniOrg = 'https://github.com/YINI-lang'
            yiniCli = 'https://github.com/YINI-lang/yini-cli'
            yiniParserTs = 'https://github.com/YINI-lang/yini-parser-typescript'
            yiniParserPython = 'https://github.com/YINI-lang/yini-parser-python'
            yiniDemoApps = 'https://github.com/YINI-lang/yini-demo-apps'
            yiniSyntax = 'https://github.com/YINI-lang/syntax-highlighting'
            yiniHomepage = 'https://github.com/YINI-lang/yini-homepage'
            yiniSpec = 'https://github.com/YINI-lang/YINI-spec'

        ^^^ yiniWiki
            getYINITools = 'https://github.com/YINI-lang/YINI-spec/wiki/Get-YINI-Tools'

        ^^^ discussions
            yiniLang = 'https://github.com/orgs/YINI-lang/discussions'
            yiniCli = 'https://github.com/YINI-lang/yini-cli/discussions'
            yiniParserTs = 'https://github.com/YINI-lang/yini-parser-typescript/discussions'
            yiniHomepage = 'https://github.com/YINI-lang/yini-homepage/discussions'
