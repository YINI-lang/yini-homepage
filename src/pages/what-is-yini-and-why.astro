                </p>
            </li>
            <li>
                <a
                    href={CONFIG.urls.external.gitHub.yiniOrg}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-slate-300 no-underline hover:text-sky-300 hover:underline"
