                    */
                }
                <a href={CONFIG.siteLinks.hero.getStarted.url}>Get Started</a
                ><br />
                <p class="mt-2">
                    Learn how to install and parse your first config in minutes.
                </p>
            </li>
            <!--li>
            <a href="/yini-playground">Try it Online</a><br />
            <p class="mt-2">Try it in the Playground.</p>
        </li-->
            <li>
                {
                    /*
                    STEP:    Code Examples
                    PURPOSE: Visual reinforcement
                    EFFECT:  Trust
                    */
                }
                <a href={CONFIG.siteLinks.hero.examples.url}>Code Examples</a
