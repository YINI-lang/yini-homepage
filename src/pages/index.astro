---
// src/pages/index.astro
import DivStatusBadges from '../components/DivStatusBadges.astro'
// import GitHubSocialProof from '../components/GitHubSocialProof.astro'
import { RandomHeadlineH1 } from '../components/RandomHeadline'
import CONFIG from '../config/conf'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDayOfMonth } from '../utils/date'

/*
    NOTE: This page is the main front door to the project.
    - Its job is to help different kinds of visitors quickly understand:

    1. What YINI is
    2. What kind of project it is
    3. Where to go next

    Wording here should not be too promotional. It should be shorter and more neutral than on a ads landing page.
*/

type EcosystemStatus = 'done' | 'inprogress' | 'planned' | '' | null

export interface EcosystemCell {
    label: string | null
    status: EcosystemStatus
}

export interface EcosystemRow {
    core: EcosystemCell
    impl: EcosystemCell
    adopt: EcosystemCell
}

export type EcosystemMatrix = EcosystemRow[]

const rows: EcosystemMatrix = [
    {
        core: { label: 'Language Specification (RC)', status: 'done' },
        impl: { label: null, status: null },
        adopt: { label: null, status: null },
    },
    {
        core: {
            label: 'Parsing Rules (Lenient & Strict) (RC)',
            status: 'done',
        },
        impl: { label: 'TypeScript Parser (Primary)', status: 'done' },
        adopt: { label: null, status: null },
    },
    {
        core: { label: 'Formal Grammar (ANTLR) (RC)', status: 'done' },
        impl: { label: 'CLI Tool (Parse & Convert YINI)', status: 'done' },
        adopt: { label: 'Homepage & Docs', status: 'done' },
    },
    {
        core: { label: null, status: null },
        impl: {
            label: 'Editor Syntax Highlighting Grammar (VS Code / TextMate)',
            status: 'done',
        },
        adopt: { label: 'Cheat Sheet (Quick Syntax Guide)', status: 'done' },
    },
    {
        core: { label: null, status: null },
        impl: {
            label: 'YINI Test Suite / Parser Compatibility Tests',
            status: 'done',
        },
        adopt: { label: 'Example Projects', status: 'inprogress' },
    },
    {
        core: { label: null, status: null },
        impl: { label: 'Python Parser (Beta)', status: 'inprogress' },
        adopt: { label: null, status: null },
    },
]

const statusIcon = (status: EcosystemStatus) => {
    if (status === 'done') return '✔'
    if (status === 'inprogress') return '◐'
    if (status === 'planned') return '○'

    return '' // Empty.
}
---

<BaseLayout
    headTitle={CONFIG.text.mainPage.headTitle}
    headDescription={CONFIG.text.mainPage.headDescription}
>
    <section class="mx-auto max-w-5xl px-4 py-2 text-center">
        <!-- <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">
            {CONFIG.text.headline}
        </h1> -->
        {/* HERO: Headline */}
        <RandomHeadlineH1 headlines={CONFIG.text.headline} client:load />

        <div class="pb-8">
            <!-- {getDayOfMonth() % 5 === 0 && <GitHubSocialProof />} -->
            <div
                class="mb-8 text-sm font-medium tracking-[0.06em] text-slate-500"
            >
                {CONFIG.text.heroCredibilityLine}
            </div>

            <p class="mt-3 text-base md:text-lg">
                {/* HERO: Elevator pitch */}
                {CONFIG.text.elevatorPitch}
            </p>
        </div>

        <div
            class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 py-3 text-sm text-slate-700 md:text-base dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
        >
            {/* Positioning line */}
            <span class="ml-1"
                >Looks like INI, handles structure like JSON — without YAML's
                indentation pitfalls.</span
            >
        </div>

        <div
            class="mt-6 flex flex-wrap items-center justify-center gap-3 pt-6 pb-4"
        >
            <a
                href={CONFIG.siteLinks.hero.getStarted.url}
                class="btn btn-primary"
            >
                Get Started
            </a>

            <a
                href={CONFIG.siteLinks.hero.playground.url}
                class="inline-block underline"
            >
                Playground
            </a>
        </div>
    </section>

    <section class="">
        <h3>Example of YINI code:</h3>
        <p>
            <a href="./samples/config.yini.png"
                ><img
                    class="mt-0 mb-1 rounded-lg border-2 border-black/90"
                    src="./samples/config.yini.png"
                    alt="File config.yini"
                /></a
            >
            Source file: <a href="./samples/config.yini" target="_blank"
                >config.yini</a
            >
        </p>
    </section>

    <!-- <section class="pb-6">
        {/* The "big idea" */}
        <h2>🧠 The big idea</h2>
        <p>
            YINI is configuration that looks familiar — but stays clean even as
            it grows.
        </p>
        <ul class="mt-2">
            <li class="leading-relaxed">Simple at first.</li>
            <li class="leading-relaxed">Structured when needed.</li>
            <li class="leading-relaxed">Easy to maintain.</li>
            <li class="leading-relaxed">Readable all the way.</li>
        </ul>
    </section> -->

    <section class="why-yini pt-4 pb-4">
        <h2 class="mt-1">Why YINI?</h2>

        <p>
            INI, <a
                href="https://www.json.org"
                target="_blank"
                rel="noopener noreferrer">JSON</a
            >, <a
                href="https://yaml.org/"
                target="_blank"
                rel="noopener noreferrer">YAML</a
            >, <a
                href="https://www.w3.org/TR/xml/"
                target="_blank"
                rel="noopener noreferrer">XML</a
            >, and TOML all solve configuration in different ways. YINI focuses
            on a practical middle ground: readable files, explicit structure,
            useful data types, and predictable parsing.
        </p>

        <ul>
            <li class="leading-relaxed">
                <strong>No indentation traps.</strong>
                Structure is defined by section markers, not whitespace.
            </li>
            <li class="leading-relaxed">
                <strong>Readable as files grow.</strong>
                Nested sections help larger configurations stay easy to scan.
            </li>
            <li class="leading-relaxed">
                <strong>Human-friendly editing.</strong>
                Comments, simple key-value pairs, and familiar syntax keep files
                approachable.
            </li>
            <li class="leading-relaxed">
                <strong>Predictable behavior.</strong>
                Clear rules and a formal grammar help tools parse YINI consistently.
            </li>
        </ul>

        <p class="mt-2">
            More info: <a
                href={CONFIG.siteLinks.navMenu.start.whatIsYINIAndWhy.url}
                class="underline">What is YINI and Why?</a
            >
        </p>
    </section>

    {/* Tooling + Practical usage section */}
    <section class="pb-6">
        <h2>How YINI is used in practice</h2>

        <p class="mt-1">
            Use YINI wherever you need structured configuration — without the
            usual complexity.
        </p>

        <ul class="mt-2">
            <li class="leading-relaxed">
                🛠 Validate and convert YINI files from the command line with
                the <a href="/tools/yini-cli">YINI CLI tool</a>.
                <div class="text-sm">
                    It can export parsed data as JSON, YAML, XML, or JavaScript.
                </div>
            </li>

            <li class="leading-relaxed">
                📦 Load YINI directly in TypeScript/JavaScript applications with
                the <a href="/tools/yini-parser-ts"
                    >YINI Parser for TypeScript</a
                >.
            </li>
            <li class="leading-relaxed">
                🐍 Load YINI directly in Python scripts, tools, and applications
                with the <a href="/tools/yini-parser-python"
                    >YINI Parser for Python</a
                >.
            </li>

            <li class="leading-relaxed">
                🧩 Use YINI for configuration files, data files, tooling, and <a
                    href="/use-yini/ci-with-yini-cli">CI workflows</a
                >.
            </li>
        </ul>
    </section>

    <!-- Quick Start -->
