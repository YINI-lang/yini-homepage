                        <td>✅</td>
                        <td>✅</td>
                        <td>❌</td>
                        <td>✅</td>
                        <td>➖</td>
                        <td>✅</td>
                    </tr>
                    <tr>
                        <td>Formal specification / grammar</td>
                        <td>✅</td>
                        <td>✅</td>
                        <td>❌</td>
                        <td>✅</td>
                        <td>✅</td>
                        <td>✅</td>
                    </tr>
                    <tr>
                        <td>Nested sections / structured data</td>
                        <td>✅</td>
                        <td>✅</td>
                        <td>➖</td>
                        <td>✅</td>
                        <td>✅</td>
                        <td>✅</td>
                    </tr>
                    <tr>
                        <td
                            >Nested structure without dotted keys or indentation
                            rules (*)</td
                        >
                        <td>✅</td>
                        <td>✅</td>
                        <td>➖</td>
                        <td>✅</td>
                        <td>❌</td>
                        <td>➖</td>
                    </tr>
