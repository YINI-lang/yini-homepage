---
// src/pages/index.astro
import { RandomHeadlineH1 } from '../components/RandomHeadline'
import CONFIG from '../config/conf'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
    headTitle="YINI Configuration Format — Clear, Structured Config Files"
    headDescription="Official site for YINI, an INI-inspired settings/configuration format with clear structure, predictable rules, and a formal specification."
>
    <section class="mx-auto max-w-5xl px-4 py-2 text-center">
        <!-- <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">
            {CONFIG.text.headline}
        </h1> -->
        <RandomHeadlineH1 headlines={CONFIG.text.headline} client:load />
        <p class="mt-3 text-base md:text-lg">
            {CONFIG.text.elevatorPitch}
        </p>

        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <a href="/get-started" class="btn btn-primary"> Get Started </a>

            <!-- !!Temp disabled
            <a href="/playground" class="btn btn-outline"> Open Playground </a>
            -->

            <a href="/yini-tutorial" class="inline-block underline">
                Quick tutorial
            </a>
        </div>
    </section>

    <section class="why-yini pb-4">
        <h2>💡 Why YINI?</h2>
        INI, YAML, and JSON all solve configuration problems in different ways.<br
        />
        INI emphasizes simplicity, YAML offers expressive structure, and JSON prioritizes
        precision.<br />
        YINI focuses on keeping configuration files readable while providing clear
        nesting and predictable behavior.
        <ul>
            <li class="leading-relaxed">
                <strong>Clear structure without indentation-based rules</strong>
                — YINI uses explicit structure instead of indentation-based semantics,
                so files stay readable and predictable.
            </li>
            <li class="leading-relaxed">
                <strong
                    >Readable section nesting that scales with file size</strong
                > — YINI supports nesting and structured data while keeping configuration
                files easy to scan and maintain.
            </li>
            <li class="leading-relaxed">
                <strong>Optimized for human-edited configuration</strong> — The format
                prioritizes clarity, comments, and consistency for day-to-day configuration
                work.
            </li>
            <li class="leading-relaxed">
                <strong>Predictable behavior defined by clear rules</strong> — YINI
                has a formal grammar and well-defined parsing rules, reducing surprises
                across tools.
            </li>
            <li class="leading-relaxed">
                <strong
                    >A balanced middle ground between simplicity and structure</strong
                > — It offers more structure than INI, less noise than XML/JSON,
                and fewer edge cases than YAML.
            </li>
        </ul>
    </section>

    <!-- Quick Start -->
    <div class="yini-quick-start full-bleed pr-8">
        <section class="mx-auto max-w-3xl pt-1 pb-6">
            <h2>⚡ TL;DR — Quick Start</h2>
            <h3 class="pl-4">Try YINI in three quick steps:</h3>

            <ul class="space-y-6">
                <li>
                    <h3>1) Create a file</h3>
                    Save the two lines below as <code>config.yini</code>:<br />
                    <pre><code class="language-yini">{`^ App
name = 'Hello'`}</code></pre>
                    <p>
                        <span role="img" aria-label="warning">⚠️</span>
                        Make sure you save the file with the <code>.yini</code> extension
                        (not <code>.txt</code>).
                    </p>
                </li>

                <li>
                    <h3>2) Run this in your terminal</h3>
                    <p>From the same folder where you saved the file:</p>
                    <pre><code class="language-bash">npx yini-cli parse config.yini</code></pre>
                </li>

                <li>
                    <h3>3) See the result</h3>
                    <p>This prints the following JavaScript object:</p>
                    <pre><code class="language-yini">{`{ App: { name: 'Hello' } }`}</code></pre>
                </li>

                <li>
                    <h3>Bonus: Pretty-printed JSON output</h3>
                    <p>
                        Use the <code>--pretty</code> flag, and run this line:
                    </p>
                    <pre><code class="language-bash">npx yini-cli parse config.yini --pretty</code></pre>
                    <p>Which gives the following (JSON):</p>
                    <pre><code class="language-json">{`{
    "App": {
        "name": "Hello"
    }
}
`}</code></pre>
                </li>
            </ul>
        </section>
    </div>

    <section class="pb-6">
        <h2>📝 Example</h2>
        <h3>YINI code:</h3>
        <pre><code class="language-yini">{`^ App
  name = "My App"
  version = "1.2.3"
  pageSize = 25
  darkTheme = off
`}</code></pre>

        <h3>Parsed output (JS):</h3>
        <pre><code class="language-js">{`{
    "App": {
        "name": "My App",
        "version": "1.2.3",
        "pageSize": 25,
        "darkTheme": false
    }
}`}</code></pre>
    </section>

    <div class="yini-features full-bleed pr-8">
        <section class="mx-auto max-w-3xl pt-1 pb-6">
            <h2>🧩 Key Features</h2>
            <ol>
                <li>
                    <strong>Readable and familiar</strong>
                    <p class="mt-2">
                        Plain-text configuration files built from simple
                        key–value pairs (
                        <code>key = value</code>), inspired by classic INI.
                    </p>
                </li>
                <li>
                    <strong>Clear structure</strong>
                    <p class="mt-2">
                        Supports nested sections using explicit section markers
                        (such as <code>^</code>), creating a clear hierarchy
                        without relying on indentation.<br />
                        For example:
                        <code>^ App</code>, <code>^^ Server</code>, and
                        <code>^^^ Logging</code>.
                    </p>
                </li>
                <li>
                    <strong>Useful data types</strong>
                    <p class="mt-2">
                        Supports strings, numbers, booleans, arrays, and objects
                        — including nested structures — so configuration can
                        stay structured without becoming verbose.
                    </p>
                </li>
                <li>
                    <strong>Comments where you expect them</strong>
                    <p class="mt-2">
                        Supports both line comments (<code>#</code>, <code
                            >//</code
                        > and block comments (<code>/* ... */</code>), making it
                        easy to document configuration directly in the file.
                    </p>
                </li>
                <li>
                    <strong>Reduced syntax noise</strong>
                    <p class="mt-2">
                        Keeps files readable by avoiding excessive brackets,
                        quotes, and long dotted key paths. <code
                            >server.database.advanced.param</code
                        >).
                    </p>
                </li>
                <li>
                    <strong>Predictable and well-defined</strong>
                    <p class="mt-2">
                        Defined by a formal, versioned specification and grammar
                        to ensure consistent behavior across tools.
                    </p>
                </li>
                <li>
                    <strong>Free and open source</strong>
                    <p class="mt-2">
                        YINI is open-source software, free to use, inspect, and
                        build upon.
                    </p>
                </li>
            </ol>
        </section>
    </div>

    <p class="mt-3 text-base md:text-base">
        <h2>ℹ️ About</h2>
        <p>
            YINI is a new configuration format, <strong
                >formalized in 2025</strong
            >. It's a structured configuration format designed for clarity, easy
            nesting, and strict validation.
        </p>
        <p>
            The format's syntax and behavior are defined in the
            <strong>YINI Specification</strong>, currently at
            <strong>Version 1.0 — Candidate Release</strong>.
        </p>
        <p>
            YINI was created and is maintained by Marko K. Seppänen as an
            open-source project under the <a
                href="https://github.com/YINI-lang"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 no-underline hover:text-sky-300 hover:underline"
                >YINI-lang organization</a
            >.
            <p>
                The specification, tooling, and ecosystem are actively evolving
                toward the first stable release.
            </p>
        </p>
    </p>

    <section>
        <h2>🛠️ Contribute & Get Involved</h2>
        <p class="mt-3">
            YINI is open-source and evolving. You can help by trying it,
            reporting issues, contributing code, or just ⭐ the project on
            GitHub.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
            <a
                href={CONFIG.urls.external.gitHub.yiniOrg}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center rounded-lg border px-4 py-2"
                >GitHub Org ↗</a
            >
            <a
                href={CONFIG.siteLinks.hero.spec.url}
                class="inline-flex items-center rounded-lg border px-4 py-2"
                >Read the Spec</a
            >
        </div>
    </section>

    <section>
        <h2>🔭 Next steps</h2>
        <ul>
            <li>
                <a href="/get-started">Get Started</a><br />
                <p class="mt-2">Learn how to install and use YINI from CLI.</p>
            </li>
            <!--li>
            <a href="/yini-playground">Try it Online</a><br />
            <p class="mt-2">Try it in the Playground.</p>
        </li-->
            <li>
                <a href="/yini-tutorial">Quick Tutorial</a><br />
                <p class="mt-2">
                    5-minute guided walkthrough of YINI — the basics of the YINI
                    format and how to validate it.
                </p>
            </li>
            <li>
                <a href="/specification">Specification</a><br />
                <p class="mt-2">
                    Official YINI format rules — Full technical details of the
                    YINI format.
                </p>
            </li>
            <li>
                <a href="/yini-faq">FAQ</a><br />
                <p class="mt-2">Common questions answered.</p>
            </li>
        </ul>
    </section>

    <section>
        <hr />
        <h3>Build & Release Status</h3>
        <div class="flex items-center justify-between">
            <div>
                Parser (Node.js) library: <code>yini-parser</code>

                <a
                    href="https://www.npmjs.com/package/yini-parser"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        style="margin-top: 8px; margin-bottom: 8px;"
                        src="https://img.shields.io/npm/v/yini-parser.svg"
                        alt="npm version"
                    />
                </a>
                <a
                    href="https://github.com/YINI-lang/yini-parser-typescript/actions/workflows/run-all-tests.yml"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        style="margin-top: 8px; margin-bottom: 8px;"
                        src="https://github.com/YINI-lang/yini-parser-typescript/actions/workflows/run-all-tests.yml/badge.svg"
                        alt="All Test Suites status"
                    />
                </a>
            </div>
            <div>
                CLI tool: <code>yini-cli</code>

                <a
                    href="https://www.npmjs.com/package/yini-cli"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        style="margin-top: 8px; margin-bottom: 8px;"
                        src="https://img.shields.io/npm/v/yini-cli.svg"
                        alt="npm version"
                    />
                </a>
                <a
                    href="https://github.com/YINI-lang/yini-cli/actions/workflows/run-all-tests.yml"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <img
                        style="margin-top: 8px; margin-bottom: 8px;"
                        src="https://github.com/YINI-lang/yini-cli/actions/workflows/run-all-tests.yml/badge.svg"
                        alt="All Test Suites status"
                    />
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
