---
// src/pages/index.astro
import DivStatusBadges from '../components/DivStatusBadges.astro'
import GitHubSocialProof from '../components/GitHubSocialProof.astro'
import { RandomHeadlineH1 } from '../components/RandomHeadline'
import CONFIG from '../config/conf'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getDayOfMonth } from '../utils/date'

/*
    NOTE: This page is the main front door to the project.
    - Its job is to help different kinds of visitors quickly understand:

    1. What YINI is
    2. What kind of project it is
    3. Where to go next

    Wording here should not be too promotional. It should be shorter and more neutral than on a ads landing page.
*/

type EcosystemStatus = 'done' | 'inprogress' | 'planned' | '' | null

export interface EcosystemCell {
    label: string | null
    status: EcosystemStatus
}

export interface EcosystemRow {
    core: EcosystemCell
    impl: EcosystemCell
    adopt: EcosystemCell
}

export type EcosystemMatrix = EcosystemRow[]

const rows: EcosystemMatrix = [
    {
        core: { label: 'Language Specification (RC)', status: 'done' },
        impl: { label: null, status: null },
        adopt: { label: null, status: null },
    },
    {
        core: {
            label: 'Parsing Rules (Lenient & Strict) (RC)',
            status: 'done',
        },
        impl: { label: 'TypeScript Parser (Primary)', status: 'done' },
        adopt: { label: null, status: null },
    },
    {
        core: { label: 'Formal Grammar (ANTLR) (RC)', status: 'done' },
        impl: { label: 'CLI Tool (Parse & Convert YINI)', status: 'done' },
        adopt: { label: 'Homepage & Docs', status: 'done' },
    },
    {
        core: { label: null, status: null },
        impl: {
            label: 'Editor Syntax Highlighting grammar (VS Code / TextMate)',
            status: 'done',
        },
        adopt: { label: 'Cheat Sheet (Quick Syntax Guide)', status: 'done' },
    },
    {
        core: { label: '', status: '' },
        impl: { label: 'Python Parser (Alpha, PyPI)', status: 'inprogress' },
        adopt: { label: 'Example Projects', status: 'inprogress' },
    },
    // {
    //     core: { label: null, status: null },
    //     impl: { label: null, status: null },
    //     adopt: {
    //         label: null /*'Community & Contributors'*/,
    //         status: null /* 'planned'*/,
    //     },
    // },
]

const statusIcon = (status: EcosystemStatus) => {
    if (status === 'done') return '✔'
    if (status === 'inprogress') return '◐'
    if (status === 'planned') return '○'

    return '' // Empty.
}
---

<BaseLayout
    headTitle={CONFIG.text.mainPage.headTitle}
    headDescription={CONFIG.text.mainPage.headDescription}
>
    <section class="mx-auto max-w-5xl px-4 py-2 text-center">
        <!-- <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">
            {CONFIG.text.headline}
        </h1> -->
        {/* HERO: Headline */}
        <RandomHeadlineH1 headlines={CONFIG.text.headline} client:load />

        <div class="pb-8">
            {getDayOfMonth() % 5 === 0 && <GitHubSocialProof />}

            <p class="mt-3 text-base md:text-lg">
                {/* HERO: Elevator pitch */}
                {CONFIG.text.elevatorPitch}
            </p>
        </div>

        <div
            class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 py-3 text-sm text-slate-700 md:text-base dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
        >
            {/* Positioning line */}
            <span class="ml-1"
                >Looks like INI, handles structure like JSON — without YAML's
                indentation pitfalls.</span
            >
        </div>

        <div
            class="mt-6 flex flex-wrap items-center justify-center gap-3 pt-6 pb-4"
        >
            <a
                href={CONFIG.siteLinks.hero.getStarted.url}
                class="btn btn-primary"
            >
                Get Started
            </a>

            <!-- !!Temp disabled
            <a href="/playground" class="btn btn-outline"> Open Playground </a>
            -->

            <a
                href={CONFIG.siteLinks.hero.tutorial.url}
                class="inline-block underline"
            >
                Quick tutorial
            </a>
        </div>
    </section>

    <section class="">
        <h3>Example of YINI code:</h3>
        <p>
            <a href="./samples/config.yini.png"
                ><img
                    class="mt-0 mb-1 rounded-lg border-2 border-black/90"
                    src="./samples/config.yini.png"
                    alt="File config.yini"
                /></a
            >
            Source file: <a href="./samples/config.yini" target="_blank"
                >config.yini</a
            >
        </p>
    </section>

    <!-- <section class="pb-6">
        {/* The "big idea" */}
        <h2>🧠 The big idea</h2>
        <p>
            YINI is configuration that looks familiar — but stays clean even as
            it grows.
        </p>
        <ul class="mt-2">
            <li class="leading-relaxed">Simple at first.</li>
            <li class="leading-relaxed">Structured when needed.</li>
            <li class="leading-relaxed">Easy to maintain.</li>
            <li class="leading-relaxed">Readable all the way.</li>
        </ul>
    </section> -->

    <section class="why-yini pt-4 pb-4">
        <h2 class="mt-1">Why YINI?</h2>
        INI, YAML, <a
            href="https://www.w3.org/TR/xml/"
            target="_blank"
            rel="noopener noreferrer">XML</a
        >, and JSON all approach configuration differently, each with tradeoffs:<br
        />
        INI favors simplicity, YAML offers expressive structure, and JSON prioritizes
        precision.<br />
        <strong>YINI</strong> focuses on keeping configuration readable while providing
        clear nesting and predictable behavior.
        <ul>
            <li class="leading-relaxed">
                <strong>No indentation traps.</strong>
                Clear structure without <a
                    href="https://yaml.org/"
                    target="_blank"
                    rel="noopener noreferrer">YAML</a
                >-style surprises.
            </li>

            <li class="leading-relaxed">
                <strong>Designed to remain readable as files grow.</strong>
                Nest sections without losing clarity.
            </li>

            <li class="leading-relaxed">
                <strong>Designed for human readability.</strong>
                Easy to edit, comment, and maintain.
            </li>

            <li class="leading-relaxed">
                <strong>Predictable behavior.</strong>
                Clear rules. Fewer edge cases.
            </li>

            <li class="leading-relaxed">
                <strong>A practical balance of simplicity and structure.</strong
                >
                More structure than INI, less noise than <a
                    href="https://www.json.org"
                    target="_blank"
                    rel="noopener noreferrer">JSON</a
                >.
            </li>
        </ul>

        <p class="mt-2">
            More info: <a
                href={CONFIG.siteLinks.navMenu.start.whatIsYINIAndWhy.url}
                class="underline">What is YINI and Why?</a
            >
        </p>

        <section class="mt-2 pt-4 pb-4">
            <h2 class="mt-5">Why YINI was created</h2>
            Many configuration formats become harder to maintain as projects grow.
            <ul>
                <li class="leading-relaxed">
                    <strong>INI</strong> becomes flat and unstructured.
                </li>
                <li class="leading-relaxed">
                    <strong>JSON</strong> becomes noisy and hard to edit.
                </li>
                <li class="leading-relaxed">
                    <strong>YAML</strong> becomes fragile and unpredictable.
                </li>
            </ul>
            YINI was designed to address these issues.
        </section>

        {/* Tooling + Practical usage section */}
        <section class="pb-6">
            <h2>How YINI is used in practice</h2>

            <p class="mt-1">
                Use YINI wherever you need structured configuration — without
                the usual complexity.
            </p>

            <ul class="mt-2">
                <li class="leading-relaxed">
                    🛠 Validate and convert YINI files to JSON from the command
                    line with the <a href="/tools/yini-cli">YINI CLI tool</a>.
                    <div class="text-sm">
                        (It can also export parsed data as YAML, XML, and
                        JavaScript.)
                    </div>
                </li>

                <li class="leading-relaxed">
                    📦 Load YINI directly in TypeScript/JavaScript applications
                    with the <a href="/tools/yini-parser-ts"
                        >YINI Parser for TypeScript</a
                    >.
                </li>
                <li class="leading-relaxed">
                    🐍 Load YINI directly in Python scripts, tools, and
                    applications with the <a href="/tools/yini-parser-python"
                        >YINI Parser for Python</a
                    >.
                </li>

                <li class="leading-relaxed">
                    🧩 Use YINI for configuration files, data files, tooling,
                    and <a href="/use-yini/ci-with-yini-cli">CI workflows</a>.
                </li>
            </ul>
        </section>

        <!-- Quick Start -->
        <div class="yini-quick-start full-bleed px-8">
            <section class="mx-auto max-w-3xl pt-1 pb-6">
                <h2>⚡ TL;DR — Quick Start</h2>
                <h3 class="pl-4">Try YINI in three simple steps:</h3>
                <p class="pl-4 text-sm text-slate-500">
                    Requires Node.js installed.
                </p>

                <ul class="space-y-6">
                    <li>
                        <h3>1) Create a file</h3>
                        Save these two lines as <code>config.yini</code>: <i
                            >(No build step or project setup required.)</i
                        >
                        <pre><code class="language-yini">{`^ App
name = "Hello"`}</code></pre>
                        <p>
                            <span role="img" aria-label="warning">💡</span>
                            Make sure you save the file with the <code
                                >.yini</code
                            > extension (not <code>.txt</code>).
                        </p>
                    </li>

                    <li>
                        <h3>2) Run this in your terminal</h3>
                        <p>
                            From your terminal (with Node.js installed), in the
                            same folder where you saved the file, run this:
                        </p>
                        <pre><code class="language-bash">npx yini-cli parse config.yini</code></pre>
                        <p>JSON is the default output format.</p>
                    </li>

                    <li>
                        <h3>3) See the result</h3>
                        <p>You should now see the following (JSON):</p>
                        <pre><code class="language-json">{`{
    "App": {
        "name": "Hello"
    }
}
`}</code></pre>
                    </li>
                    <p class="text-sm text-slate-500">
                        Nice — you just parsed your first YINI file.
                    </p>

                    <li>
                        <h3>Bonus: JavaScript output</h3>
                        <pre><code class="language-bash">npx yini-cli parse config.yini --js</code></pre>
                        <p>
                            Use <code>--js</code> to output a JavaScript-style object
                            instead:
                        </p>
                        <pre><code class="language-js">{`{
    App: {
        name: "Hello"
    }
}
`}</code></pre>
                    </li>
                </ul>
            </section>
        </div>

        <section class="mx-auto max-w-5xl px-4 py-2 text-center">
            <div
                class="mt-6 flex flex-wrap items-center justify-center gap-3 pt-6 pb-4"
            >
                <a
                    href={CONFIG.siteLinks.hero.getStarted.url}
                    class="btn btn-primary"
                >
                    Get Started
                </a>

                <a
                    href={CONFIG.urls.external.gitHub.yiniOrg}
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="trackClick('gitHub.yiniOrgCtaClicked')"
                    class="inline-block underline"
                >
                    View on GitHub ↗
                </a>
            </div>
        </section>

        <section class="mt-20 pb-4">
            <h2>🌐 The YINI Ecosystem</h2>

            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-sm">
                    <thead>
                        <tr
                            class="border-b border-slate-300 dark:border-slate-700"
                        >
                            <th class="py-3 text-left font-semibold">🧠 Core</th
                            >
                            <th class="py-3 text-left font-semibold"
                                >🛠 Implementation</th
                            >
                            <th class="py-3 text-left font-semibold"
                                >🌍 Adoption</th
                            >
                        </tr>
                    </thead>

                    <tbody>
                        {
                            rows.map((row) => (
                                <tr class="border-b border-slate-200 transition hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-900">
                                    <td class="py-3 pr-4">
                                        <div class="flex items-center gap-2">
                                            <span class="text-green-600">
                                                {statusIcon(row.core.status)}
                                            </span>
                                            {row.core.label}
                                        </div>
                                    </td>

                                    <td class="py-3 pr-4">
                                        <div class="flex items-center gap-2">
                                            <span
                                                class={
                                                    row.impl.status === 'done'
                                                        ? 'text-green-600'
                                                        : row.impl.status ===
                                                            'inprogress'
                                                          ? 'text-yellow-500'
                                                          : 'text-slate-400'
                                                }>
                                                {statusIcon(row.impl.status)}
                                            </span>
                                            {row.impl.label}
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        <div class="flex items-center gap-2">
                                            <span
                                                class={
                                                    row.adopt.status === 'done'
                                                        ? 'text-green-600'
                                                        : row.adopt.status ===
                                                            'inprogress'
                                                          ? 'text-yellow-500'
                                                          : 'text-slate-400'
                                                }>
                                                {statusIcon(row.adopt.status)}
                                            </span>
                                            {row.adopt.label}
                                        </div>
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            <div
                class="mt-4 text-center text-xs text-slate-500 dark:text-slate-400"
            >
                ✔ Complete &nbsp; ◐ In progress &nbsp; ○ Planned
            </div>
            <div
                class="mt-4 text-center text-xs text-slate-500 dark:text-slate-400"
            >
                RC &nbsp;=&nbsp; Release Candidate
            </div>
        </section>

        <section class="pb-6">
            <h2>📝 Example</h2>
            <h3>YINI code:</h3>
            <p>
                <a href="./samples/settings.yini.png"
                    ><img
                        class="mt-0 mb-1 rounded-lg border-2 border-black/90"
                        src="./samples/settings.yini.png"
                        alt="File settings.yini"
                    /></a
                >
                Source file: <a href="./samples/settings.yini" target="_blank"
                    >settings.yini</a
                >
            </p>

            <h3>Parsed output (JSON):</h3>
            <pre><code class="language-json">{`{
    "Settings": {
        "serviceId": "NebulaService",
        "release": "3.2.1",
        "debugMode": false,
        "tagline": "\"Nebula\" is a cloud of gas and dust in outer space.",
        "Network": {
            "bindAddress": "127.0.0.1",
            "bindPort": 8080,
            "allowedOrigins": [
                "https://myapp.com",
                "http://localhost:3000"
            ]
        },
        "Capabilities": {
            "enableSearch": true,
            "experimental": [
                "new-ui",
                "streaming-api"
            ],
            "pools": {
                "min_units": 2,
                "max_units": 5,
                "size_mb": 128,
                "timeout_sec": 90
            }
        },
        "DB Config": {
            "host": "db.internal",
            "ssl": true,
            "Security": {
                "username": "service_user",
                "password": "****"
            }
        }
    }
}`}</code></pre>

            <p class="mt-2 text-sm">
                New to YINI? Read a short <a
                    href={CONFIG.siteLinks.navMenu.learnYini.learnYiniFormat
                        .url}
                    class="underline">learn the YINI format</a
                >.
            </p>
        </section>

        <div class="yini-features full-bleed px-8">
            <section class="mx-auto max-w-3xl pt-1 pb-6">
                <h2>🧩 Key Features</h2>
                <ol>
                    <li>
                        <strong>Clear section markers</strong>
                        <p class="mt-2 leading-normal">
                            Sections start with <code>^</code> by default:
                        </p>
                        <pre><code>^ App
title = "MyApp"</code></pre>
                        <p>
                            Nested sections use repeated <code>^</code> markers to
                            indicate section levels — similar concept like Markdown's
                            heading levels:
                            <code>^ App</code>, <code>^^ Server</code>, <code
                                >^^^ Logging</code
                            >. This creates a clear section hierarchy without
                            relying on indentation.
                        </p>
                        <p>
                            YINI also supports alternative section markers such
                            as <code>&lt;</code>.
                        </p>
                    </li>
                    <li>
                        <strong>Predictable and well-defined</strong>
                        <p class="mt-2">
                            Defined by a formal, versioned specification and
                            grammar (<code>ANTLR4</code>) to ensure consistent
                            behavior across tools.
                        </p>
                    </li>
                    <li>
                        <strong>Simple key–value pairs</strong>
                        <p class="mt-2 leading-normal">
                            Inside a section, configuration is written as:
                        </p>
                        <pre><code>key = value</code></pre>
                        <p>
                            This keeps files readable and familiar, inspired by
                            classic INI.
                        </p>
                    </li>
                    <li>
                        <strong>Structured like YAML, readable like INI</strong>
                        <p class="mt-2 leading-normal">
                            Useful data types (similar to JSON):
                        </p>
                        <ul>
                            <li>Nested sections</li>
                            <li>Lists (arrays)</li>
                            <li>Objects (JavaScript objects)</li>
                            <li>Strings and numbers</li>
                            <li>Booleans and nulls</li>
                        </ul>
                    </li>
                    <li>
                        <strong>Comments where you expect them</strong>
                        <p class="mt-2 leading-normal">
                            Supports both line comments (<code>#</code>, <code
                                >//</code
                            >, <code>;</code> and block/multi-line comments <code
                                >/* ... */</code
                            >), making it easy to document configuration
                            directly in the file.
                        </p>
                    </li>
                    <li>
                        <strong>Reduced syntax noise</strong>
                        <p class="mt-2 leading-normal">
                            Keeps files readable by avoiding excessive brackets,
                            quotes, and long dotted key paths such as <code
                                >server.database.advanced.param</code
                            >.
                        </p>
                    </li>
                    <li>
                        <strong>Free and open source</strong>
                        <p class="mt-2">
                            YINI is open-source software, free to use, inspect,
                            and build upon.
                        </p>
                    </li>
                </ol>

                <p>
                    💡 For syntax & quick reference: See <a
                        href={CONFIG.siteLinks.navMenu.refs.cheatSheet.url}
                        class="inline-block underline"
                    >
                        YINI Cheat Sheet
                    </a>
                </p>
            </section>
        </div>

        <section class="my-6 pt-4">
            <h1 class="mt-5">⚖️ How YINI compares to other config formats</h1>
            <div style="overflow-x:auto">
                <p class="mb-2 text-sm text-slate-500">
                    YINI supports both lenient and strict parsing modes,
                    depending on how much enforcement you need. Lenient mode is
                    the default.
                </p>
                <table>
                    <thead>
                        <tr>
                            <th>Feature</th>
                            <th>YINI (lenient)</th>
                            <th>YINI (strict)</th>
                            <th>INI</th>
                            <th>JSON</th>
                            <th>YAML</th>
                            <th>TOML</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>Human readability by default</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>➖</td>
                            <td>➖</td>
                            <td>✅</td>
                            <td>➖</td>
                        </tr>
                        <tr>
                            <td>Readability at scale</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>❌</td>
                            <td>➖</td>
                            <td>➖</td>
                        </tr>
                        <tr>
                            <td>Predictable parsing</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>✅</td>
                        </tr>
                        <tr>
                            <td>Formal specification / grammar</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>✅</td>
                        </tr>
                        <tr>
                            <td>Nested structure</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>➖</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>✅</td>
                        </tr>
                        <tr>
                            <td>Comments</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>✅</td>
                            <td>✅</td>
                        </tr>
                        <tr>
                            <td>Syntax overhead</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>➖</td>
                            <td>➖</td>
                        </tr>

                        <tr>
                            <td>Configuration-oriented design</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>➖</td>
                            <td>✅</td>
                            <td>✅</td>
                        </tr>
                        <tr>
                            <td>Diagnostic clarity</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>➖</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>✅</td>
                        </tr>
                        <tr>
                            <td
                                >Tolerance for incomplete or hand-edited input</td
                            >
                            <td>✅</td>
                            <td>❌</td>
                            <td>➖</td>
                            <td>❌</td>
                            <td>➖</td>
                            <td>❌</td>
                        </tr>
                        <tr>
                            <td>Strength of structural validation</td>
                            <td>➖</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>✅</td>
                            <td>➖</td>
                            <td>✅</td>
                        </tr>
                        <tr>
                            <td>Suitability for larger configurations</td>
                            <td>✅</td>
                            <td>✅</td>
                            <td>❌</td>
                            <td>➖</td>
                            <td>➖</td>
                            <td>➖</td>
                        </tr>
                        <tr>
                            <td>Industry familiarity</td>
                            <td>Low</td>
                            <td>Low</td>
                            <td>Very strong</td>
                            <td>Very strong</td>
                            <td>Very strong</td>
                            <td>Moderate</td>
                        </tr>
                        <tr>
                            <td>Native tooling availability</td>
                            <td>Limited / growing</td>
                            <td>Limited / growing</td>
                            <td>Moderate</td>
                            <td>Very strong</td>
                            <td>Very strong</td>
                            <td>Strong</td>
                        </tr>
                        <tr>
                            <td>Ecosystem maturity</td>
                            <td>Limited / growing</td>
                            <td>Limited / growing</td>
                            <td>Mature but fragmented</td>
                            <td>Very strong</td>
                            <td>Very strong</td>
                            <td>Strong</td>
                        </tr>
                    </tbody>
                </table>

                <p class="mt-2 text-sm text-slate-500">
                    <strong>Lenient</strong> = flexibility & convenience ·
