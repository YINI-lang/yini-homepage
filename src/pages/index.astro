                        <td>✅</td>
                        <td>✅</td>
                        <td>❌</td>
                        <td>➖</td>
                        <td>➖</td>
                    </tr>

                    <tr>
                        <td>Configuration-oriented design</td>
                        <td>✅</td>
                        <td>✅</td>
                        <td>✅</td>
                        <td>➖</td>
                        <td>✅</td>
                        <td>✅</td>
                    </tr>
                    <tr>
                        <td>Diagnostic clarity</td>
                        <td>✅</td>
                        <td>✅</td>
                        <td>➖</td>
                        <td>✅</td>
                        <td>❌</td>
                        <td>✅</td>
                    </tr>
                    <tr>
                        <td>Tolerance for incomplete or hand-edited input</td>
                        <td>✅</td>
                        <td>❌</td>
                        <td>➖</td>
                        <td>❌</td>
                        <td>➖</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Strength of structural validation</td>
                        <td>➖</td>
                        <td>✅</td>
                        <td>❌</td>
                        <td>✅</td>
                        <td>➖</td>
                        <td>✅</td>
