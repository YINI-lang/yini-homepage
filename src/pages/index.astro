---
// src/pages/index.astro
import DivStatusBadges from '../components/DivStatusBadges.astro'
import { RandomHeadlineH1 } from '../components/RandomHeadline'
import CONFIG from '../config/conf'
import BaseLayout from '../layouts/BaseLayout.astro'

type EcosystemStatus = 'done' | 'inprogress' | 'planned' | '' | null

export interface EcosystemCell {
    label: string | null
    status: EcosystemStatus
}

export interface EcosystemRow {
    core: EcosystemCell
    impl: EcosystemCell
    adopt: EcosystemCell
}

export type EcosystemMatrix = EcosystemRow[]

// --- npm downloads ---------
const res1 = await fetch(
    'https://api.npmjs.org/downloads/point/last-week/yini-parser',
)
const data1 = await res1.json()

const res2 = await fetch(
    'https://api.npmjs.org/downloads/point/last-week/yini-cli',
)
const data2 = await res2.json()

const weeklyDownloads = data1.downloads + data2.downloads
// ---

// --- GitHub stars ---------
const repos = [
    'yini-spec',
    'yini-parser-typescript',
    'yini-cli',
    'yini-demo-apps',
    'yini-syntax',
]

let totalStars = 0

for (const repo of repos) {
    const res = await fetch(`https://api.github.com/repos/YINI-lang/${repo}`)
    const data = await res.json()
    totalStars += data.stargazers_count
}
// --------------------------

const rows: EcosystemMatrix = [
    {
        core: { label: 'Language Specification', status: 'done' },
        impl: { label: null, status: null },
        adopt: { label: null, status: null },
    },
    {
        core: { label: 'Parsing Rules (Strict & Lenient)', status: 'done' },
        impl: { label: 'TypeScript Parser (Primary)', status: 'done' },
        adopt: { label: null, status: null },
    },
    {
        core: { label: 'Formal Grammar (ANTLR)', status: 'done' },
        impl: { label: 'CLI Tool (Parse & Convert YINI)', status: 'done' },
        adopt: { label: 'Homepage & Docs', status: 'done' },
    },
    {
        core: { label: null, status: null },
        impl: { label: 'Python Parser', status: 'planned' },
        adopt: { label: 'Cheat Sheet (Quick Syntax Guide)', status: 'done' },
    },
    {
        core: { label: '', status: '' },
        impl: {
            label: 'Editor Syntax Highlighting (VS Code / TextMate)',
            status: 'done',
        },
        adopt: { label: 'Example Projects', status: 'inprogress' },
    },
    // {
    //     core: { label: null, status: null },
    //     impl: { label: null, status: null },
    //     adopt: {
    //         label: null /*'Community & Contributors'*/,
    //         status: null /* 'planned'*/,
    //     },
    // },
]

const statusIcon = (status: EcosystemStatus) => {
    if (status === 'done') return '✔'
    if (status === 'inprogress') return '◐'
    if (status === 'planned') return '○'

    return '' // Empty.
}
---

<BaseLayout
    headTitle={CONFIG.text.mainPage.headTitle}
    headDescription={CONFIG.text.mainPage.headDescription}
>
    <section class="mx-auto max-w-5xl px-4 py-2 text-center">
        <!-- <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">
            {CONFIG.text.headline}
        </h1> -->
        <RandomHeadlineH1 headlines={CONFIG.text.headline} client:load />
        <div class="mt-2 flex justify-center pb-8">
            <span
                class="rounded-md bg-slate-100 px-3 py-1 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-300"
            >
                ⭐ {totalStars} GitHub stars across YINI repos
            </span>&nbsp;
            <span
                class="rounded-md bg-slate-100 px-3 py-1 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-300"
            >
                📦 {weeklyDownloads} npm downloads last week
            </span>
        </div>

        <p class="mt-3 text-base md:text-lg">
            {CONFIG.text.elevatorPitch}
        </p>

        <div
            class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 py-3 text-sm text-slate-700 md:text-base dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200"
        >
            <span class="ml-1"
                >Looks like INI, handles structure like JSON — without YAML's
                indentation pitfalls.</span
            >
        </div>

        <div
            class="mt-6 flex flex-wrap items-center justify-center gap-3 pt-6 pb-4"
        >
            <a
                href={CONFIG.siteLinks.hero.getStarted.url}
                class="btn btn-primary"
            >
                Get Started
            </a>

            <!-- !!Temp disabled
            <a href="/playground" class="btn btn-outline"> Open Playground </a>
            -->

            <a
                href={CONFIG.siteLinks.hero.tutorial.url}
                class="inline-block underline"
            >
                Quick tutorial
            </a>
        </div>
    </section>

    <section class="">
        <h3>Example of YINI code:</h3>
        <p>
            <a href="./samples/config.yini.png"
                ><img
                    class="mt-0 mb-1 rounded-lg border-2 border-black/90"
                    src="./samples/config.yini.png"
                    alt="File config.yini"
                /></a
            >
            Source file: <a href="./samples/config.yini" target="_blank"
                >config.yini</a
            >
        </p>
    </section>

    <section class="pb-6">
        <h2>✨ The big idea</h2>
        <p>
            YINI is configuration that looks familiar — but stays clean even as
            it grows.
        </p>
        <ul class="mt-2">
            <li class="leading-relaxed">Simple at first.</li>
            <li class="leading-relaxed">Structured when needed.</li>
            <li class="leading-relaxed">Easy to maintain.</li>
            <li class="leading-relaxed">Readable all the way.</li>
        </ul>
    </section>

    <section class="why-yini pb-4">
        <h2 class="mt-1">💡 Why YINI?</h2>
        INI, YAML, and JSON all approach configuration differently, each with tradeoffs:<br
        />
        INI favors simplicity, YAML offers expressive structure, and JSON prioritizes
        precision.<br />
        <strong>YINI</strong> focuses on keeping configuration readable while providing
        clear nesting and predictable behavior.
        <ul>
            <li class="leading-relaxed">
                <strong>No indentation traps.</strong>
                Clear structure without YAML-style surprises.
            </li>

            <li class="leading-relaxed">
                <strong>Readable as files grow.</strong>
                Nest sections without losing clarity.
            </li>

            <li class="leading-relaxed">
                <strong>Designed for humans.</strong>
                Easy to edit, comment, and maintain.
            </li>

            <li class="leading-relaxed">
                <strong>Predictable behavior.</strong>
                Clear rules. Fewer edge cases.
            </li>

            <li class="leading-relaxed">
                <strong>The right balance.</strong>
                More structure than INI, less noise than JSON.
            </li>
        </ul>

        <p class="mt-2">
            More info: <a
                href={CONFIG.siteLinks.navMenu.start.whatIsYINIAndWhy.url}
                class="underline">What is YINI and Why?</a
            >
        </p>

        <section class="pb-4">
            <h2>💡 How can YINI be used?</h2>

            <p class="mt-1">
                Use YINI wherever you need structured configuration — without
                the usual complexity.
            </p>

            <ul class="mt-2">
                <li class="leading-relaxed">
                    🛠 Convert YINI → JSON with a simple CLI.
                </li>
                <li class="leading-relaxed">
                    📦 Load YINI directly into your app as native objects.
                </li>
                <li class="leading-relaxed">
                    🧩 Use it for configs, data files, pipelines, and tooling.
                </li>
            </ul>
        </section>

        <!-- Quick Start -->
        <div class="yini-quick-start full-bleed pr-8">
            <section class="mx-auto max-w-3xl pt-1 pb-6">
                <h2>⚡ TL;DR — Quick Start</h2>
                <h3 class="pl-4">Try YINI in three simple steps:</h3>

                <ul class="space-y-6">
                    <li>
                        <h3>1) Create a file</h3>
                        Save the two lines below as <code>config.yini</code>: <i
                            >(no build step, no dependencies required)</i
                        >
                        <pre><code class="language-yini">{`^ App
name = "Hello"`}</code></pre>
                        <p>
                            <span role="img" aria-label="warning">⚠️</span>
                            Make sure you save the file with the <code
                                >.yini</code
                            > extension (not <code>.txt</code>).
                        </p>
                    </li>

                    <li>
                        <h3>2) Run this in your terminal</h3>
                        <p>From the same folder where you saved the file:</p>
                        <pre><code class="language-bash">npx yini-cli parse config.yini</code></pre>
                        <p>JSON is the default output format.</p>
                    </li>

                    <li>
                        <h3>3) See the result</h3>
                        <p>You should now see the following (JSON):</p>
                        <pre><code class="language-json">{`{
    "App": {
        "name": "Hello"
    }
}
`}</code></pre>
                    </li>
                    <p class="text-sm text-slate-500">
                        Nice — you just parsed your first YINI file.
                    </p>

                    <li>
                        <h3>Bonus: JavaScript output</h3>
                        <pre><code class="language-bash">npx yini-cli parse config.yini --js</code></pre>
                        <p>
                            Use <code>--js</code> to output a JavaScript-style object:
                        </p>
                        <pre><code class="language-js">{`{
    App: {
        name: "Hello"
    }
}
`}</code></pre>
                    </li>
                </ul>
            </section>
        </div>

        <section class="mx-auto max-w-5xl px-4 py-2 text-center">
            <div
                class="mt-6 flex flex-wrap items-center justify-center gap-3 pt-6 pb-4"
            >
                <a
                    href={CONFIG.siteLinks.hero.getStarted.url}
                    class="btn btn-primary"
                >
                    Get Started
                </a>

                <a
                    href={CONFIG.urls.external.gitHub.yiniOrg}
                    target="_blank"
                    rel="noopener noreferrer"
                    onclick="trackClick('gitHub.yiniOrgCtaClicked')"
                    class="inline-block underline"
                >
                    View on GitHub ↗
                </a>
            </div>
        </section>

        <section class="mt-20 pb-4">
            <h2 class="mb-4 text-center text-2xl font-semibold">
                🌐 The YINI Ecosystem
            </h2>

            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-sm">
                    <thead>
                        <tr
                            class="border-b border-slate-300 dark:border-slate-700"
                        >
                            <th class="py-3 text-left font-semibold">🧠 Core</th
                            >
                            <th class="py-3 text-left font-semibold"
                                >🛠 Implementation</th
                            >
                            <th class="py-3 text-left font-semibold"
                                >🌍 Adoption</th
                            >
                        </tr>
                    </thead>

                    <tbody>
                        {
                            rows.map((row) => (
                                <tr class="border-b border-slate-200 transition hover:bg-slate-50 dark:border-slate-800 dark:hover:bg-slate-900">
                                    <td class="py-3 pr-4">
                                        <div class="flex items-center gap-2">
                                            <span class="text-green-600">
                                                {statusIcon(row.core.status)}
                                            </span>
                                            {row.core.label}
                                        </div>
                                    </td>

                                    <td class="py-3 pr-4">
                                        <div class="flex items-center gap-2">
                                            <span
                                                class={
                                                    row.impl.status === 'done'
                                                        ? 'text-green-600'
                                                        : row.impl.status ===
                                                            'inprogress'
                                                          ? 'text-yellow-500'
                                                          : 'text-slate-400'
                                                }>
                                                {statusIcon(row.impl.status)}
                                            </span>
                                            {row.impl.label}
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        <div class="flex items-center gap-2">
                                            <span
                                                class={
                                                    row.adopt.status === 'done'
                                                        ? 'text-green-600'
                                                        : row.adopt.status ===
                                                            'inprogress'
                                                          ? 'text-yellow-500'
                                                          : 'text-slate-400'
                                                }>
                                                {statusIcon(row.adopt.status)}
                                            </span>
                                            {row.adopt.label}
                                        </div>
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            <div
                class="mt-4 text-center text-xs text-slate-500 dark:text-slate-400"
            >
                ✔ Complete &nbsp; ◐ In progress &nbsp; ○ Planned
            </div>
        </section>

        <section class="pb-6">
            <h2>📝 Example</h2>
            <h3>YINI code:</h3>
            <p>
                <a href="./samples/settings.yini.png"
                    ><img
                        class="mt-0 mb-1 rounded-lg border-2 border-black/90"
                        src="./samples/settings.yini.png"
                        alt="File settings.yini"
                    /></a
                >
                Source file: <a href="./samples/settings.yini" target="_blank"
                    >settings.yini</a
                >
            </p>

            <h3>Parsed output (JSON):</h3>
            <pre><code class="language-json">{`{
    "Settings": {
        "serviceId": "NebulaService",
        "release": "3.2.1",
        "debugMode": false,
        "tagline": "\"Nebula\" is a cloud of gas and dust in outer space.",
        "Network": {
            "bindAddress": "127.0.0.1",
            "bindPort": 8080,
            "allowedOrigins": [
                "https://myapp.com",
                "http://localhost:3000"
            ]
        },
        "Capabilities": {
            "enableSearch": true,
            "experimental": [
                "new-ui",
                "streaming-api"
            ],
            "pools": {
                "min_units": 2,
                "max_units": 5,
                "size_mb": 128,
                "timeout_sec": 90
            }
        },
        "DB Config": {
            "host": "db.internal",
            "ssl": true,
            "Security": {
                "username": "service_user",
                "password": "****"
            }
        }
    }
}`}</code></pre>

            <p class="mt-2 text-sm">
                New to YINI? Read a short <a
                    href={CONFIG.siteLinks.navMenu.learnYini.learnYiniFormat
                        .url}
                    class="underline">learn the YINI format</a
                >.
            </p>
        </section>

        <div class="yini-features full-bleed pr-8">
            <section class="mx-auto max-w-3xl pt-1 pb-6">
                <h2>🧩 Key Features</h2>
                <ol>
                    <li>
                        <strong>Clear section markers</strong>
                        <p class="mt-2 leading-normal">
                            Sections start with <code>^</code> by default:
                        </p>
                        <pre><code>^ App
title = "MyApp"</code></pre>
                        <p>
                            Nested sections use repeated <code>^</code> markers to
                            indicate section levels — similar concept like Markdown's
                            heading levels:
                            <code>^ App</code>, <code>^^ Server</code>, <code
                                >^^^ Logging</code
                            >. This creates a clear section hierarchy without
                            relying on indentation.
                        </p>
                        <p>
                            YINI also supports alternative section markers such
                            as <code>&lt;</code>.
                        </p>
                    </li>
                    <li>
                        <strong>Predictable and well-defined</strong>
                        <p class="mt-2">
                            Defined by a formal, versioned specification and
                            grammar (<code>ANTLR4</code>) to ensure consistent
                            behavior across tools.
                        </p>
                    </li>
                    <li>
                        <strong>Simple key–value pairs</strong>
                        <p class="mt-2 leading-normal">
                            Inside a section, configuration is written as:
                        </p>
                        <pre><code>key = value</code></pre>
                        <p>
                            This keeps files readable and familiar, inspired by
                            classic INI.
                        </p>
                    </li>
                    <li>
                        <strong>Structured like YAML, readable like INI</strong>
                        <p class="mt-2 leading-normal">
                            Useful data types (similar to JSON):
                        </p>
                        <ul>
                            <li>Nested sections</li>
                            <li>Lists (arrays)</li>
                            <li>Objects (JavaScript objects)</li>
                            <li>Strings and numbers</li>
                            <li>Booleans and nulls</li>
                        </ul>
                    </li>
                    <li>
                        <strong>Comments where you expect them</strong>
                        <p class="mt-2 leading-normal">
                            Supports both line comments (<code>#</code>, <code
                                >//</code
                            >, <code>;</code> and block/multi-line comments <code
                                >/* ... */</code
                            >), making it easy to document configuration
                            directly in the file.
                        </p>
                    </li>
                    <li>
                        <strong>Reduced syntax noise</strong>
                        <p class="mt-2 leading-normal">
                            Keeps files readable by avoiding excessive brackets,
                            quotes, and long dotted key paths such as <code
                                >server.database.advanced.param</code
                            >.
                        </p>
                    </li>
                    <li>
                        <strong>Free and open source</strong>
                        <p class="mt-2">
                            YINI is open-source software, free to use, inspect,
                            and build upon.
                        </p>
                    </li>
                </ol>

                <p>
                    💡 For syntax & quick reference: See <a
                        href={CONFIG.siteLinks.navMenu.refs.cheatSheet.url}
                        class="inline-block underline"
                    >
                        YINI Cheat Sheet
                    </a>
                </p>
            </section>
        </div>

        <section class="mt-3 text-base md:text-base">
            <h2>ℹ️ About</h2>
            <p>
                YINI is an INI-inspired configuration format designed for
                clarity, simple nesting, and predictable parsing.
            </p>
            <p>
                The format is defined by a formal, versioned specification and
                maintained as an open-source project under the YINI-lang
                organization on GitHub.
            </p>
        </section>

        <section>
            <h2>🛠️ Contribute & Get Involved</h2>
            <p class="mt-3">
                YINI is open-source and actively maintained. You can get
                involved by trying it, reporting issues, contributing code, or
                just ⭐ the project on GitHub.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
                <a
                    href={CONFIG.urls.external.yiniWiki.getYINITools}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center rounded-lg border px-4 py-2"
                >
                    ⬇️ Get YINI Tools ↗
                </a>
                <a
                    href={CONFIG.urls.external.gitHub.yiniOrg}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center rounded-lg border px-4 py-2"
                    >GitHub Org ↗</a
                >
            </div>
        </section>

        <hr />

        <section>
            <h2>🔭 Next steps</h2>
            <ul>
                <li>
                    {
                        /*
                    STEP:    Get Started
                    PURPOSE: Immediate action
                    EFFECT:  Momentum
                    */
                    }
                    <a href={CONFIG.siteLinks.hero.getStarted.url}
                        >Get Started</a
                    ><br />
                    <p class="mt-2">
                        Learn how to install and parse your first config in
                        minutes.
                    </p>
                </li>
                <!--li>
            <a href="/yini-playground">Try it Online</a><br />
            <p class="mt-2">Try it in the Playground.</p>
        </li-->
                <li>
                    {
                        /*
                    STEP:    Quick Tutorial
                    PURPOSE: Rapid understanding
                    EFFECT:  Confidence
                    */
                    }
                    <a href={CONFIG.siteLinks.hero.tutorial.url}
                        >Quick Tutorial</a
                    ><br />
                    <p class="mt-2">
                        5-minute guided walkthrough of the YINI format and
                        validation basics.
                    </p>
                </li>
                <li>
                    {
                        /*
                    STEP:    Code Examples
                    PURPOSE: Visual reinforcement
                    EFFECT:  Trust
                    */
                    }
                    <a href={CONFIG.siteLinks.hero.examples.url}
                        >Code Examples</a
                    ><br />
                    <p class="mt-2">
                        Real-world YINI examples showing common configuration
                        patterns.
                    </p>
                </li>
                <li>
                    {
                        /*
                    STEP:    FAQ
                    PURPOSE: Reduce friction
                    EFFECT:  Reassurance
                    */
                    }
                    <a href={CONFIG.siteLinks.hero.faq.url}>FAQ</a><br />
                    <p class="mt-2">
                        Common questions about using YINI in real projects.
                    </p>
                </li>
                <li>
                    {
                        /*
                    STEP:    Specification
                    PURPOSE: Technical validation
                    EFFECT:  Commitment
                    */
                    }
                    <a href={CONFIG.siteLinks.hero.spec.url}>Specification</a
                    ><br />
                    <p class="mt-2">
                        Official YINI format rules with full technical details
                        of the YINI format.
                    </p>
                </li>
            </ul>
        </section>

        <section>
            <hr />
            <h3>Project status</h3>
            <DivStatusBadges />
        </section>
    </section>
</BaseLayout>
