---
// src/pages/tools/yini-cli/manual.astro
import PageEndingLinks from '../../../components/PageEndingLinks.astro'
import CONFIG from '../../../config/conf'
import yiniCliHelp from '../../../content/generated/cli/yini-cli-help.txt?raw'
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout
    headTitle={'YINI CLI Command Reference'}
    headDescription={'Main yini-cli usage reference, including help output, common commands, and quick examples.'}
>
    <section aria-labelledby="yini-cli-manual" class="mt-8">
        <h1 id="yini-cli-manual">YINI CLI Command Reference</h1>
        <p>
            The YINI CLI is the official command-line tool for validating,
            parsing, and converting YINI files from a terminal. For a friendlier
            overview with install notes and examples, see the <a
                href={CONFIG.siteLinks.navMenu.tools.yiniCli.url}
                >YINI CLI page</a
            >.
        </p>

        <pre><code>{yiniCliHelp}</code></pre>

        <hr />

        <PageEndingLinks />
    </section>
</BaseLayout>
