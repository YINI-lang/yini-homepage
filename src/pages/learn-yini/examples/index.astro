---
// learn-yini/examples/basic.astro
import PageEndingLinks from '../../../components/PageEndingLinks.astro'
import YINIExample from '../../../components/YINIExample.astro'
import CONFIG from '../../../config/conf'
import exampleHelloWorld from '../../../content/examples/basic/hello-world.yini?raw'
import exampleSettings from '../../../content/examples/basic/settings.yini?raw'
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout
    headTitle={'Code Examples: YINI'}
    headDescription={'Practical YINI configuration examples, from simple configs to advanced structured data examples.'}
>
    <section class="mt-8">
        <h1>YINI Code Examples</h1>
        <div class="text-sm">
            <p class="text-slate-600">
                Minimal, common and real-world configuration examples in the
                YINI format.
            </p>
            <p>
                Explore practical configuration examples written in the YINI
                configuration format, ranging from simple beginner-friendly
                examples to larger real-world configurations.
            </p>
        </div>

        <h2>A quick/minimal example</h2>
        <YINIExample title="Hello world" code={exampleHelloWorld} />

        <YINIExample title="A bit fuller example" code={exampleSettings} />

        <hr />

        <section class="pb-4">
            <h2>Explore example pages/collections</h2>

            <p
                class="text-base leading-relaxed text-slate-600 dark:text-slate-400"
            >
                Not sure where to start? Pick the collection that matches where
                you are — from first steps to full-scale configs.
            </p>

            <ul class="mt-5 space-y-1.5">
                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples.basic
                            .url}
                        class="group flex items-start gap-3 rounded-lg border border-slate-200 px-4 py-1 !no-underline transition hover:border-slate-300 hover:bg-slate-50 hover:!no-underline dark:border-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800/40"
                    >
                        <div class="min-w-0 flex-1">
                            <h3 class="leading-tight font-medium underline">
                                Core and basic examples
                            </h3>
                            <p
                                class="mt-0.5 text-sm leading-snug text-slate-600 dark:text-slate-400"
                            >
                                Start here if you are new to YINI. These small
                                examples introduce sections, keys, values,
                                comments, and basic structure.
                            </p>
                        </div>
                    </a>
                </li>

                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples
                            .indentation.url}
                        class="group flex items-start gap-3 rounded-lg border border-slate-200 px-4 py-1 !no-underline transition hover:border-slate-300 hover:bg-slate-50 hover:!no-underline dark:border-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800/40"
                    >
                        <div class="min-w-0 flex-1">
                            <h3 class="leading-tight font-medium underline">
                                Indentation and nesting styles
                            </h3>
                            <p
                                class="mt-0.5 text-sm leading-snug text-slate-600 dark:text-slate-400"
                            >
                                See how YINI nesting works. Compare indented and
                                non-indented styles, and learn why section
                                markers define the structure.
                            </p>
                        </div>
                    </a>
                </li>

                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples.values
                            .url}
                        class="group flex items-start gap-3 rounded-lg border border-slate-200 px-4 py-1 !no-underline transition hover:border-slate-300 hover:bg-slate-50 hover:!no-underline dark:border-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800/40"
                    >
                        <div class="min-w-0 flex-1">
                            <h3 class="leading-tight font-medium underline">
                                Value literal examples
                            </h3>
                            <p
                                class="mt-0.5 text-sm leading-snug text-slate-600 dark:text-slate-400"
                            >
                                Compare strings, booleans, number formats, digit
                                separators, and other everyday value syntax.
                            </p>
                        </div>
                    </a>
                </li>

                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples.common
                            .url}
                        class="group flex items-start gap-3 rounded-lg border border-slate-200 px-4 py-1 !no-underline transition hover:border-slate-300 hover:bg-slate-50 hover:!no-underline dark:border-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800/40"
                    >
                        <div class="min-w-0 flex-1">
                            <h3 class="leading-tight font-medium underline">
                                Common real-world examples
                            </h3>
                            <p
                                class="mt-0.5 text-sm leading-snug text-slate-600 dark:text-slate-400"
                            >
                                Look at practical configuration patterns for
                                apps, tools, services, and everyday project
                                settings.
                            </p>
                        </div>
                    </a>
                </li>

                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples
                            .advanced.url}
                        class="group flex items-start gap-3 rounded-lg border border-slate-200 px-4 py-1 !no-underline transition hover:border-slate-300 hover:bg-slate-50 hover:!no-underline dark:border-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800/40"
                    >
                        <div class="min-w-0 flex-1">
                            <h3 class="leading-tight font-medium underline">
                                Advanced feature examples
                            </h3>
                            <p
                                class="mt-0.5 text-sm leading-snug text-slate-600 dark:text-slate-400"
                            >
                                Explore more flexible syntax, richer values,
                                parser behavior, and features you may need in
                                larger or more demanding files.
                            </p>
                        </div>
                    </a>
                </li>

                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples.large
                            .url}
                        class="group flex items-start gap-3 rounded-lg border border-slate-200 px-4 py-1 !no-underline transition hover:border-slate-300 hover:bg-slate-50 hover:!no-underline dark:border-slate-700 dark:hover:border-slate-600 dark:hover:bg-slate-800/40"
                    >
                        <div class="min-w-0 flex-1">
                            <h3 class="leading-tight font-medium underline">
                                Large examples
                            </h3>
                            <p
                                class="mt-0.5 text-sm leading-snug text-slate-600 dark:text-slate-400"
                            >
                                Browse bigger configuration files and see how
                                YINI reads when a file grows beyond small
                                examples.
                            </p>
                        </div>
                    </a>
                </li>
            </ul>
        </section>

        <PageEndingLinks />
    </section>
</BaseLayout>
