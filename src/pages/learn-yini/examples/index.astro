---
// learn-yini/examples/basic.astro
import YINIExample from '../../../components/YINIExample.astro'
import CONFIG from '../../../config/conf'
import exampleBasic from '../../../content/examples/basic/basic.yini?raw'
import exampleComments from '../../../content/examples/basic/comments.yini?raw'
import exampleListAndObjects from '../../../content/examples/general/lists-and-objects.yini?raw'
import exampleNumbers from '../../../content/examples/general/number-formats.yini?raw'
import exampleNestingStyle1 from '../../../content/examples/indentation/indent-ex-conf1.yini?raw'
import exampleNestingStyle2 from '../../../content/examples/indentation/indent-ex-conf2.yini?raw'
import exampleNestingStyle3 from '../../../content/examples/indentation/indent-ex-conf3.yini?raw'
import exampleNestedStructured from '../../../content/examples/structure/nested-and-structured.yini?raw'
import exampleNestedSections from '../../../content/examples/structure/nested-sections.yini?raw'
import exampleSections from '../../../content/examples/structure/sections.yini?raw'
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout
    headTitle={'Code Examples: YINI'}
    headDescription={'Real-world examples written in the YINI data format, a human-readable text format for representing structured information.'}
>
    <section class="mt-8">
        <h1>YINI Code Examples</h1>

        <section>
            <ul>
                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples.basic
                            .url}>Basic examples</a
                    ><br />
                    <em
                        >{
                            CONFIG.siteLinks.navMenu.learnYini.examples.basic
                                .title
                        }</em
                    >
                </li>
                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples.common
                            .url}>Common real-life examples</a
                    ><br />
                    <em
                        >{
                            CONFIG.siteLinks.navMenu.learnYini.examples.common
                                .title
                        }</em
                    >
                </li>
                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples
                            .advanced.url}>Advanced Features (optional)</a
                    ><br />
                    <em
                        >{
                            CONFIG.siteLinks.navMenu.learnYini.examples.advanced
                                .title
                        }</em
                    >
                </li>
                <li>
                    <a
                        href={CONFIG.siteLinks.navMenu.learnYini.examples.large
                            .url}>Large examples</a
                    ><br />
                    <em
                        >{
                            CONFIG.siteLinks.navMenu.learnYini.examples.large
                                .title
                        }</em
                    >
                </li>
            </ul>
        </section>

        <hr />

        <section>
            <h2>Next steps</h2>
            <ul>
                <li>
                    ➡️ <a href={CONFIG.siteLinks.hero.getStarted.url}
                        >Get Started</a
                    ><br />
                    <em>Learn how to install and use YINI.</em>
                </li>
                <li>
                    ➡️ <a href={CONFIG.siteLinks.hero.tutorial.url}
                        >Quick Tutorial</a
                    ><br />
                    <em>A 5-minute guided walkthrough of YINI basics.</em>
                </li>
            </ul>
        </section>
    </section>
</BaseLayout>
