---
// learn-yini/examples/basic.astro
import YINIExample from '../../../components/YINIExample.astro'
import CONFIG from '../../../config/conf'
import exampleHelloWorld from '../../../content/examples/basic/hello-world.yini?raw'
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout
    headTitle={'Code Examples: YINI'}
    headDescription={'Practical YINI configuration examples, from simple configs to advanced structured data examples.'}
>
    <section class="mt-8">
        <h1>YINI Code Examples</h1>
        <div class="text-sm">
            <p class="text-slate-600">
                Minimal, common and real-world configuration examples in the
                YINI format.
            </p>
            <p>
                Explore practical configuration examples written in the YINI
                configuration format, ranging from simple beginner-friendly
                examples to larger real-world configurations.
            </p>
        </div>

        <h2>A quick/minimal example</h2>
        <YINIExample title="Hello world" code={exampleHelloWorld} />

        <section class="py-4">
            <h2>Explore example collections</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">
                Explore grouped examples that show how YINI can be used in
                practice, from small basics to larger and more advanced
                configurations.
            </p>

            <div class="mt-5 grid gap-4 md:grid-cols-2">
                <article
                    class="rounded-xl border border-slate-200 p-4 dark:border-slate-700"
                >
                    <h3 class="text-lg font-medium">Core and basic examples</h3>
                    <p
                        class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                    >
                        Start with small, focused examples that introduce the
                        core YINI syntax and structure.
                        <a
                            href={CONFIG.siteLinks.navMenu.learnYini.examples
                                .basic.url}
                            class="underline"
                        >
                            Open examples
                        </a>
                    </p>
                </article>

                <article
                    class="rounded-xl border border-slate-200 p-4 dark:border-slate-700"
                >
                    <h3 class="text-lg font-medium">
                        Common real-world examples
                    </h3>
                    <p
                        class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                    >
                        See how YINI can be used for everyday configuration
                        patterns and practical project setups.
                        <a
                            href={CONFIG.siteLinks.navMenu.learnYini.examples
                                .common.url}
                            class="underline"
                        >
                            Open examples
                        </a>
                    </p>
                </article>

                <article
                    class="rounded-xl border border-slate-200 p-4 dark:border-slate-700"
                >
                    <h3 class="text-lg font-medium">
                        Advanced feature examples
                    </h3>
                    <p
                        class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                    >
                        Explore more advanced syntax and features for cases
                        where you need additional structure or flexibility.
                        <a
                            href={CONFIG.siteLinks.navMenu.learnYini.examples
                                .advanced.url}
                            class="underline"
                        >
                            Open examples
                        </a>
                    </p>
                </article>

                <article
                    class="rounded-xl border border-slate-200 p-4 dark:border-slate-700"
                >
                    <h3 class="text-lg font-medium">Large examples</h3>
                    <p
                        class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400"
                    >
                        Browse larger example files to see how YINI reads when
                        configurations grow in size.
                        <a
                            href={CONFIG.siteLinks.navMenu.learnYini.examples
                                .large.url}
                            class="underline"
                        >
                            Open examples
                        </a>
                    </p>
                </article>
            </div>
        </section>

        <hr />

        <section>
            <h2>Next steps</h2>
            <ul>
                <li>
                    ➡️ <a href={CONFIG.siteLinks.hero.getStarted.url}
                        >Get Started</a
                    ><br />
                    <em>Install the CLI and create your first YINI file.</em>
                </li>
                <li>
                    ➡️ <a href={CONFIG.siteLinks.hero.tutorial.url}
                        >Quick Tutorial</a
                    ><br />
                    <em>A 5-minute walkthrough of the core YINI concepts.</em>
                </li>
            </ul>
        </section>

        <p class="mt-10">
            New to YINI? Start with the <a
                href={CONFIG.siteLinks.hero.tutorial.url}>5-minute tutorial</a
            >.
        </p>
    </section>
</BaseLayout>
