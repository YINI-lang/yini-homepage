---
// learn-yini/examples/values.astro
import PageEndingLinks from '../../../components/PageEndingLinks.astro'
import YINIExample from '../../../components/YINIExample.astro'
import CONFIG from '../../../config/conf'
import exampleBooleans from '../../../content/examples/general/boolean-literals.yini?raw'
import exampleCommandStrings from '../../../content/examples/general/command-strings.yini?raw'
import exampleNumbers from '../../../content/examples/general/number-formats.yini?raw'
import exampleStringConcatenation from '../../../content/examples/general/string-concatenation.yini?raw'
import exampleStringEscapes from '../../../content/examples/general/string-escapes.yini?raw'
import exampleStringMultiline from '../../../content/examples/general/string-multiline.yini?raw'
import exampleStringBasics from '../../../content/examples/general/strings-and-escapes.yini?raw'
import exampleStringsAtAGlance from '../../../content/examples/general/strings-at-a-glance.yini?raw'
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout
    headTitle={'Value Literal Examples: YINI'}
    headDescription={'YINI examples for strings, booleans, numbers, digit separators, and other value literals.'}
>
    <section class="mt-8">
        <h1>Value Literal Examples</h1>
        <p>
            These examples focus on the basic value types used inside YINI
            members: strings, booleans, numbers, and common literal forms.
        </p>

        <p>
            Use this page when you want to compare value syntax directly. For
            sections and nesting, start with the <a
                href={CONFIG.siteLinks.navMenu.learnYini.examples.core.url}
                >Core YINI examples</a
            >.
        </p>

        <hr />

        <h2>Strings</h2>
        <p>
            Strings must be quoted using single quotes, double quotes, or triple
            double quotes. Strings are raw by default; use an E or e prefix when
            escape sequences should be interpreted.
        </p>
        <YINIExample
            title="Strings at a glance"
            code={exampleStringsAtAGlance}
        />
        <YINIExample title="Basic strings" code={exampleStringBasics} />
        <YINIExample title="Escaped strings" code={exampleStringEscapes} />
        <YINIExample title="Multi-line strings" code={exampleStringMultiline} />
        <p>
            Command Strings use lowercase <code>command"""</code> for multiline text
            with structural indentation removed. They produce ordinary strings; YINI
            does not execute their content.
        </p>
        <YINIExample
            title="Command Strings (RC7)"
            code={exampleCommandStrings}
        />
        <YINIExample
            title="String concatenation"
            code={exampleStringConcatenation}
        />

        <hr />

        <h2>Booleans</h2>
        <YINIExample title="Boolean literals" code={exampleBooleans} />

        <hr />

        <h2>Numbers</h2>
        <p>
            The number examples include decimal values, signs, exponents, base
            prefixes, and underscore digit separators such as
            <code>12_345</code> and <code>1_234_567</code>.
        </p>
        <YINIExample title="Number formats" code={exampleNumbers} />

        <PageEndingLinks />
    </section>
</BaseLayout>
