---
// learn-yini/examples/advanced.astro
import YINIExample from '../../../components/YINIExample.astro'
import CONFIG from '../../../config/conf'
import exampleFile3 from '../../../content/examples/3-cli-application-options.yini?raw'
import exampleFile5 from '../../../content/examples/5-database-connection.yini?raw'
import exampleFile6 from '../../../content/examples/6-feature-flags-example.yini?raw'
import exampleFile7 from '../../../content/examples/7-email-smtp-configuration.yini?raw'
import BaseLayout from '../../../layouts/BaseLayout.astro'
---

<BaseLayout
    headTitle={'Advanced Examples: YINI'}
    headDescription={'Advanced code examples with optional syntax, edge cases, and power features in the YINI data format (text-based).'}
>
    <section aria-labelledby="alt-formats" class="mt-8">
        <h1>Advanced YINI Code Examples</h1>

        ⚠️ <strong>Note:</strong> These examples demonstrate optional syntax, edge
        cases, and advanced features. You do <b>not</b>
        need any of these features to use YINI effectively. If you're new to YINI,
        start with the basic examples or the <a href="/get-started"
            >Get Started</a
        > guide.

        <p>
            See everyday <a href={CONFIG.siteLinks.hero.examples.url}
                >YINI configuration examples</a
            > on the main Examples page.
        </p>

        <YINIExample
            title="File example 3: cli-application-options.yini"
            code={exampleFile3}
        />
        <YINIExample
            title="File example 5: database-connection"
            code={exampleFile5}
        />
        <YINIExample
            title="File example 6: feature-flags-example.yini"
            code={exampleFile6}
        />
        <YINIExample
            title="File example 7: email-smtp-configuration"
            code={exampleFile7}
        />

        <b>Want more?</b> See <a
            href={CONFIG.siteLinks.navMenu.learnYini.examples.common.url}
            >{CONFIG.siteLinks.navMenu.learnYini.examples.common.title}</a
        >.<br />
        <b>Or more down to earth examples?</b> See <a
            href={CONFIG.siteLinks.navMenu.learnYini.examples.basic.url}
            >{CONFIG.siteLinks.navMenu.learnYini.examples.basic.title}</a
        >.

        <hr />

        <section>
            <h2>Next steps</h2>
            <ul>
                <li>
                    ➡️ <a href={CONFIG.siteLinks.hero.getStarted.url}
                        >Get Started</a
                    ><br />
                    <em>Learn how to install and use YINI.</em>
                </li>
                <li>
                    ➡️ <a href={CONFIG.siteLinks.hero.examples.url}
                        >Basic Examples</a
                    ><br />
                    <em>See minimal, everyday YINI configuration examples.</em>
                </li>
            </ul>
        </section>
    </section>
</BaseLayout>
