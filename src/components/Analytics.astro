---
// Include this component only once per page.
// Recommended placement: src/layouts/BaseLayout.astro, inside <head>.
---

<script is:inline>
    function loadYiniAnalytics() {
        const analyticsHosts = new Set(['yini-lang.org', 'www.yini-lang.org'])

        window.yiniAnalyticsEnabled = analyticsHosts.has(
            window.location.hostname,
        )

        if (!window.yiniAnalyticsEnabled) return

        // --- Plausible ------------------------------------------------------
        const plausibleScript = document.createElement('script')
        plausibleScript.async = true
        plausibleScript.src =
            'https://plausible.io/js/pa-oOVpT9K5-vDjwbxRX_5n4.js'
        document.head.appendChild(plausibleScript)

        window.plausible =
            window.plausible ||
            function () {
                const queue = window.plausible.q || []
                queue.push(arguments)
                window.plausible.q = queue
            }
        window.plausible.init =
            window.plausible.init ||
            function (options) {
                window.plausible.o = options || {}
            }
        window.plausible.init()

        // --- Google Analytics -----------------------------------------------
        const gtagScript = document.createElement('script')
        gtagScript.async = true
        gtagScript.src =
            'https://www.googletagmanager.com/gtag/js?id=G-BMK7JS36XR'
        document.head.appendChild(gtagScript)

        window.dataLayer = window.dataLayer || []
        window.gtag = function () {
            window.dataLayer.push(arguments)
        }

        window.gtag('js', new Date())
        window.gtag('config', 'G-BMK7JS36XR')

        // --- Umami ----------------------------------------------------------
        const umamiScript = document.createElement('script')
        umamiScript.defer = true
        umamiScript.src = 'https://cloud.umami.is/script.js'
        umamiScript.dataset.websiteId = 'fc9fad19-a82f-429a-a0b5-d2376198c87d'
        document.head.appendChild(umamiScript)

        // --- MS Clarity -----------------------------------------------------
        window.clarity =
            window.clarity ||
            function () {
                const queue = window.clarity.q || []
                queue.push(arguments)
                window.clarity.q = queue
            }

        const clarityScript = document.createElement('script')
        clarityScript.async = true
        clarityScript.src = 'https://www.clarity.ms/tag/y60qe0geuj'
        document.head.appendChild(clarityScript)

        // --- GoatCounter ----------------------------------------------------
        const goatCounterScript = document.createElement('script')
        goatCounterScript.async = true
        goatCounterScript.dataset.goatcounter =
            'https://yini-lang.goatcounter.com/count'
        goatCounterScript.src = 'https://gc.zgo.at/count.js'
        document.head.appendChild(goatCounterScript)
    }

    loadYiniAnalytics()
</script>
