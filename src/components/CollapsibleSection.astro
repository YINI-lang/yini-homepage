---
interface Props {
    summary: string
}

const { summary } = Astro.props
---

<details
    class="my-4 min-w-0 rounded-lg border border-slate-200 dark:border-slate-700"
>
    <summary
        class="cursor-pointer rounded-lg px-4 py-3 font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"
    >
        {summary}
    </summary>
    <div class="min-w-0 px-4 pb-4">
        <slot />
    </div>
</details>
