@yini

/*

Features:
  - The disable line "--", it's used to disable a line.
  - Sections
  - Strings (double quotes), numbers, booleans
  - A list
  - A full line-comment with ;

*/

^ CLI
command = "deploy"
dry_run = false
verbosity = 2
include_paths = ["src/", "lib/", "config/"]
--exclude_patterns: "*.test.ts", "*.spec.js"
timeout = 60

    ; Output settings.
    ^^ Output
    format = "json"
    color = yes
    log_level = "debug"
