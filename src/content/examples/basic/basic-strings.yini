// Ordinary strings are raw by default; backslashes are preserved.
format = "YINI"
title  = 'My first config' // Single quotes work too.
path   = "C:\Users\Kim\Projects"
dir    = "/usr/local/bin"

// Escaped strings interpret escape sequences.
message = E"Hello!\nWelcome to \tYINI."
text    = e'Coffee and tea are ready.\n\tLet\'s code!'

// Triple-quoted strings are useful for multiline text.
description = """
A clear and readable
multiline string.
"""
