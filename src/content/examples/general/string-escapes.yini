# string-escapes.yini
# Use Escaped Strings when escape sequences should be interpreted.

^ EscapedStrings

^^ NewlinesAndTabs
line_break = E"Line 1\nLine 2"
tabbed = E"key\tvalue"

^^ QuotesAndBackslashes
quoted = E"He said \"hello\""
folder = E"C:\\Users\\Kim\\Documents"

^^ LowercasePrefix
# The E prefix is case-insensitive.
message = e"Ready\nDone"
