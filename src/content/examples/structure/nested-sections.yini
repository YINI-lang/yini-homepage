# nested-sections.yini — clear section nesting without indentation rules.

^ App
  name = "Demo App"
  env = "production"

  ^^ Features
    caching = on
    telemetry = off

  ^^ UI
    theme = "dark"
    language = "en"

    ^^^ Editor
      font = "Fira Code"
      tabWidth = 4
      autosave = true

^ Server
  host = "0.0.0.0"
  port = 8080

  ^^ TLS
    enabled = false
    certPath = null
    keyPath = null

  ^^ Limits
    maxConnections = 200
    timeoutSeconds = 60

^ Logging
  level = "info"

  ^^ Output
    format = "json"
    color = yes
