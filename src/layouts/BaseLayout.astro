---
// src/layouts/BaseLayout.astro
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header'
import CONFIG from '../config/conf'

function removeTrailingYINI(title: string): string {
    return title.endsWith(": YINI")
        ? title.slice(0, -": YINI".length)
        : title;
}

/** Function that helps to keep HTML titles under max length characters.
 * @param maxLen Preferred max length of the total title.
 *
 * Longer titles than ~70 then, Search Engines:
 *   - May rewrite the title automatically.
 *   - May truncate too long titles.
 * 
 * NOTE: SEO best practice is usually ~50–60 chars.
 */
function makeHtmlTitle(mainTitle: string, postTitle: string, maxLen = 60){
    let res = ""    // Temp candidate title.

    res = `${mainTitle} · ${postTitle}`
    if(res.length <= maxLen) return res

    mainTitle = removeTrailingYINI(mainTitle)

    res = `${mainTitle} · ${postTitle}`
    if(res.length <= maxLen) return res

    res = `${mainTitle} · YINI Config Format`
    if(res.length <= maxLen) return res

    res = `${mainTitle} | YINI`
    if(res.length <= maxLen) return res

    res = `${mainTitle}: YINI`
    if(res.length <= maxLen) return res

    res = mainTitle
    if(res.length > maxLen){
        console.warn(`WARN: Resulted title too long in makeHtmlTitle(..), res: "${res}", >${maxLen} chars`)
    }

    return mainTitle
}

const {
    headTitle, // optional per-page
    headDescription,
} = Astro.props

const postTitle = 'Clear and Structured Config Files'
const htmlTitle = makeHtmlTitle(headTitle, postTitle, 60)

const isProd = import.meta.env.PROD
const isDev = import.meta.env.DEV

---

<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{htmlTitle}</title>
        <meta name="subject" content="YINI configuration format">

        <meta name="description" content={headDescription} />
        <meta name="keywords" content="YINI config format, YINI language, configuration file format, INI alternative, YAML alternative, TOML alternative">
        <meta name="author" content={CONFIG.meta.author} />

        {isProd && (
            <>
                <!-- Analytics by Plausible -->
                <script async src="https://plausible.io/js/pa-oOVpT9K5-vDjwbxRX_5n4.js"></script>
                <script>
                window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
                plausible.init()
                </script>

                <!-- Google tag (gtag.js) -->
                <script
                    async
                    src="https://www.googletagmanager.com/gtag/js?id=G-BMK7JS36XR"
                ></script>
                <script is:inline>
                    window.dataLayer = window.dataLayer || []
                    function gtag() {
                        dataLayer.push(arguments)
                    }
                    gtag('js', new Date())

                    gtag('config', 'G-BMK7JS36XR')
                </script>
            </>
        )}

        <!-- Optional theme colors -->
        <meta name="theme-color" content="#111827" />
        <meta name="msapplication-TileColor" content="#111827" />

        <meta property="og:title" content="YINI — A Modern, Human-Friendly Configuration Format">
        <meta property="og:description" content="Simple like INI. Structured like JSON. Predictable like Python.">
        <meta property="og:url" content="https://yini-lang.org">
        <meta property="og:image" content="https://yini-lang.org/og-card.png">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="YINI — A Modern Config Format">
        <meta name="twitter:description" content="Fast, readable, predictable. Try YINI today.">
        <meta name="twitter:image" content="https://yini-lang.org/og-card.png">

        <!-- Favicons -->
        <link rel="icon" href="/favicon.ico" sizes="any" />

        <!-- PNG fallbacks -->
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32.png"
        />

        <!-- High-res icons (useful for PWA/Android, even without a manifest) -->
        <link
            rel="icon"
            type="image/png"
            sizes="192x192"
            href="/favicon-192.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="512x512"
            href="/favicon-512.png"
        />

        <!-- Apple iOS -->
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <style>
            body {
                font:
                    16px/1.6 system-ui,
                    -apple-system,
                    Segoe UI,
                    Roboto,
                    sans-serif;
                margin: 2rem auto;
                max-width: 800px;
                padding: 0 1rem;
            }
            
            nav a {
                margin-right: 1rem;
                padding-left: .5rem;
            }

            .sidebar-active {
                font-weight: 400;
                color:var(--color-sky-600);
                background: rgb(224, 224, 224);
                padding-bottom: .2rem;
                padding-right: .2rem;
                box-shadow: inset 5px 0 0 rgb(204, 10, 10);
            }
        </style>

        <script is:inline type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "SoftwareApplication",
                "name": "YINI Configuration Format",
                "applicationCategory": "DeveloperTool",
                "description": "YINI is an INI-inspired configuration language with clear nesting, comments, and a formal specification.",
                "programmingLanguage": "YINI",
                "url": "https://yini-lang.org"
            }
        </script>
        { /* Hack to prevent flash on first load, set the initial theme before CSS paints. */ }
        <script is:inline>
            (() => {
            try {
                const saved = localStorage.getItem('theme');            // 'dark' | 'light' | null
                const system = window.matchMedia('(prefers-color-scheme: dark)').matches;
                const dark = saved ? saved === 'dark' : system;
                document.documentElement.classList.toggle('dark', dark);
            } catch {}
            })();
        </script>
    </head>

    <body>
        <!-- <body
        class="bg-white text-slate-900 transition-colors dark:bg-slate-950 dark:text-slate-100"
        > -->
        <!-- React header -->
        <Header client:idle isProd={isProd} />

        <!-- Old Main -->
        <!-- <main class="mx-auto max-w-3xl px-4 py-10">
            <article class="prose prose-slate max-w-none">
                <slot />
            </article>
        </main> -->

        <!-- Main layout: sidebar + content on desktop -->
        <main class="mx-auto max-w-7xl px-4 py-10">
        <div class="grid grid-cols-1 md:grid-cols-[260px_1fr] gap-8">
            
            <!-- LEFT NAV menu (desktop only) -->
            <aside class="hidden md:block sticky top-24 self-start">
            <nav class="text-sm text-slate-700 dark:text-slate-300 space-y-6">
                <style is:inline>
                    .sidebar-link {
                        @apply text-slate-700 dark:text-slate-300 hover:text-sky-500;
                    }
                </style>

                <!-- 1) Understanding YINI (NAV menu) -->
                <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-2">
                    Start here
                </h3>
                <ul class="space-y-2">
                    <li>
                    <a 
                        href={CONFIG.siteLinks.navMenu.intro.whatIsYINIAndWhy.url}
                        class="sidebar-link"
                    >
                        What is YINI & Why?
                    </a>
                    </li>
                </ul>
                </div>

                <!-- 2) Learn YINI (NAV menu) -->
                <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-2">
                    Learn YINI
                </h3>
                <ul class="space-y-2">
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.learnYini.learnYiniFormat.url}
                        class="sidebar-link">
                        Learn the Format
                    </a>
                    </li>
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.learnYini.quickTutorial.url}
                        class="sidebar-link">
                        Quick Tutorial
                    </a>
                    </li>
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.learnYini.examples.basic.url}
                        class="sidebar-link">
                        Code Examples: Basic
                    </a>
                    </li>
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.learnYini.examples.common.url}
                        class="sidebar-link">
                        Code Examples: Common
                    </a>
                    </li>
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.learnYini.cheatSheet.url}
                        class="sidebar-link">
                        Cheat Sheet
                    </a>
                    </li>
                </ul>
                </div>

                <!-- 3) Use YINI (NAV menu) -->
                <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-2">
                    Use YINI
                </h3>
                <ul class="space-y-2">
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.useYini.getStarted.url}
                        class="sidebar-link">
                        Get Started
                    </a>
                    </li>
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.useYini.getYINITools.url}
                        class="sidebar-link">
                        Get YINI Tools
                    </a>
                    </li>
                </ul>
                </div>

                <!-- 4) References (NAV menu) -->
                <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-2">
                    References
                </h3>
                <ul class="space-y-2">
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.refs.spec.url}
                        class="sidebar-link">
                        Specification
                    </a>
                    </li>
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.refs.faq.url}
                        class="sidebar-link">
                        FAQ
                    </a>
                    </li>
                </ul>
                </div>

                <!-- 5) About (NAV menu) -->
                <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-2">
                    About
                </h3>
                <ul class="space-y-2">
                    <li>
                    <a href={CONFIG.siteLinks.navMenu.metaInfo.about.url}
                        class="sidebar-link">
                        About YINI
                    </a>
                    </li>
                </ul>
                </div>

            </nav>
            </aside>

            <!-- MAIN CONTENT -->
            <article class="prose prose-slate max-w-none">
            <slot />
            </article>

        </div>
        </main>

        <footer class="mx-auto max-w-6xl px-4 py-8 text-center">
            <a href="#top">Back to top </a>
        </footer>
        <Footer/>

        <script is:inline>
            function trackClick(eventName, props = {}) {
                // Plausible
                if (window.plausible) {
                    plausible(eventName, { props })
                }

                // Google Analytics
                if (typeof gtag === 'function') {
                    gtag('event', eventName, {
                        link_location: window.location.pathname
                    })
                }
            }
        </script>
        <script is:inline>
            document.addEventListener('copy', function () {
                const selection = document.getSelection()?.toString().trim()
                if (selection && selection.length > 4) {
                    trackClick('TextCopied', { length: selection.length })

                    if (typeof gtag === "function") {
                        gtag('event', 'copy_code', {
                            content_length: selection.length
                        })
                    }
                }
            })
        </script>

        <script is:inline>
            function markActiveSidebarLink() {

            const current = window.location.pathname.replace(/\/$/, "");

            const links = document.querySelectorAll("aside a.sidebar-link");

            // If sidebar not yet in DOM (Astro timing), try again shortly
            if (!links.length) {
                setTimeout(markActiveSidebarLink, 50);
                return;
            }

            links.forEach(a => {
                const href = (a.getAttribute("href") || "").replace(/\/$/, "");

                // Clear previous state
                a.classList.remove("sidebar-active");

                const isMatch = href && current.startsWith(href);

                if (isMatch) {
                    a.classList.add("sidebar-active");
                }
            });
        }

        // Run on first load.
        document.addEventListener("DOMContentLoaded", markActiveSidebarLink);

        // Run on every Astro navigation (CRITICAL).
        document.addEventListener("astro:page-load", markActiveSidebarLink);
        </script>

        {isProd && (
            <>
                <!-- Simple Analytics -->
                <script is:inline 
                    async
                    src="https://scripts.simpleanalyticscdn.com/latest.js"
                ></script>
                <noscript>
                    <img
                    src="https://queue.simpleanalyticscdn.com/noscript.gif"
                    alt=""
                    referrerpolicy="no-referrer-when-downgrade"
                /></noscript>
            </>
        )}
    </body>
</html>
