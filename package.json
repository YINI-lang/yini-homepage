{
    "name": "yini-homepage",
    "private": true,
    "version": "1.0.0",
    "description": "The official YINI homepage",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "gen:config": "npx yini-cli parse src/config/config.yini --output src/config/config.json",
        "predev": "npm run gen:config",
        "dev": "astro dev --force",
        "dev:host": "astro dev --host",
        "prebuild": "npm run gen:config",
        "build": "astro build --force",
        "preview": "astro preview",
        "start": "astro preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "astro check",
        "typecheck:watch": "astro check --watch",
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('.astro', { recursive: true, force: true });\""
    },
    "dependencies": {
        "@astrojs/mdx": "^4.3.3",
        "@astrojs/sitemap": "^3.6.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "yini-parser": "^1.4.1-beta"
    },
    "overrides": {
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.4",
        "@astrojs/react": "^4.4.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.14",
        "@typescript-eslint/eslint-plugin": "^8.39.1",
        "@typescript-eslint/parser": "^8.39.1",
        "add": "^2.0.6",
        "astro": "^5.12.9",
        "astro-eslint-parser": "^1.2.2",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.33.0",
        "eslint-mdx": "^3.6.2",
        "eslint-plugin-astro": "^1.3.1",
        "eslint-plugin-react": "^7.37.5",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "process": "^0.11.10",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "tailwind": "^4.0.0",
        "tailwindcss": "^4.1.14",
        "typescript": "^5.9.2",
        "unist-util-visit": "^5.0.0"
    },
    "license": "MIT"
}
